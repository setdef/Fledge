module Fledge
  class Png
    module Filter
      def self.undo: (Integer filter, Array[Integer] line, Array[Integer] previous, Integer step) -> void

      private def self.sub: (Array[Integer] line, Integer step) -> void

      private def self.up: (Array[Integer] line, Array[Integer] previous) -> void

      private def self.average: (Array[Integer] line, Array[Integer] previous, Integer step) -> void

      private def self.paeth: (Array[Integer] line, Array[Integer] previous, Integer step) -> void

      private def self.left: (Array[Integer] line, Integer index, Integer step) -> Integer

      private def self.predict: (Integer left, Integer up, Integer up_left) -> Integer
    end
  end
end
