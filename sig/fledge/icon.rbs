module Fledge
  class Icon
    MINIMUM: Integer
    ICNS: Array[[String, Integer]]
    WINDOWS: Array[Integer]
    LINUX: Array[Integer]

    @source: Integer
    @sizes: Hash[Integer, Png]
    @encoded: Hash[Integer, String]

    def self.read: (String path) -> Icon

    def initialize: (Png image, ?path: String) -> void

    def image: (Integer size) -> Png

    private def source_side: (Integer size) -> Integer

    def png: (Integer size) -> String

    def icns: () -> String

    def windows_images: () -> Array[[Integer, String]]

    def ico: () -> String

    def self.bitmap: (Png image) -> String

    def self.shrink: (Png image, Integer size) -> Png

    private def self.halve: (Png image) -> Png

    private def self.weights: (Integer from, Integer to) -> Array[Array[[Integer, Float]]]

    private def self.average: (Array[Integer] source, Integer width, Array[[Integer, Float]] row_weights, Array[[Integer, Float]] column_weights) -> Array[Integer]
  end
end
