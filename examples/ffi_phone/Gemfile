# The ffi gem, whose extconf.rb builds the libffi it bundles before its
# own extension, and adds that library to the Makefile mkmf wrote.
# fledge build ios and fledge build android compile both for each of the
# phone's targets and link them into the app.
source "https://rubygems.org"

gem "ffi", "1.17.4"
