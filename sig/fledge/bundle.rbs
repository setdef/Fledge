module Fledge
  class Bundle
    WITHOUT: Array[Symbol]
    SETTINGS: String
    GEMSPECS: String
    FORCE_RUBY_PLATFORM: String

    @app: App
    @lockfile: String
    @gemfile: String
    @definition: Bundler::Definition
    @checksums: Hash[String, String]
    @build_args: Hash[String, Array[String]]
    @with: Array[String]
    @without: Array[String]
    @groups: Array[Symbol]
    @sources: Sources?

    def initialize: (App app) -> void

    def build_args: (String name) -> Array[String]

    def lockfile_name: () -> String

    private def read_groups: (Bundler::Definition definition) -> void

    private def build_settings: () -> Hash[String, Array[String]]

    private def definition: (String gemfile) -> Bundler::Definition

    private def empty_checksum_advice: (String message) -> String

    private def at_project: [T] (String gemfile) { () -> T } -> T

    private def checksums: (String text) -> Hash[String, String]

    def gems_for: (target platform, ruby_version: String, arch: String) ?{ (LockedGem gem) -> Gem::Requirement } -> Array[locked_gem]

    def bundler_for: (String running, ruby_version: String) ?{ (LockedGem gem) -> Gem::Requirement } -> LockedGem?

    private def switch_version: (Gem::Version running) -> Gem::Version?

    private def runs?: (Bundler::LazySpecification spec, target platform, Gem::Version version, (^(LockedGem gem) -> Gem::Requirement)? required_ruby) -> bool

    private def check_ruby: (String ruby_version) -> void

    private def check_locked: (target platform, Gem::Platform target) -> void

    def app_files: (?force_ruby_platform: bool) -> Hash[String, String]

    private def group_settings: () -> String

    private def own_folders: () -> Array[String]

    private def sources: () -> Sources
  end
end
