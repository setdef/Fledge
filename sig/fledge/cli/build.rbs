module Fledge
  class CLI
    class Build
      DEFAULT_OUT: String

      @out: CLI::_Output
      @err: CLI::_Output
      @env: Runtimes::_Env
      @host: Gem::Platform
      @ruby: String

      def initialize: (out: CLI::_Output, err: CLI::_Output, ?env: Runtimes::_Env, ?host: Gem::Platform, ?ruby: String) -> void

      def call: (Array[String]) -> Integer

      private def signing: (Options options, Platform host) -> Signing::signer?

      private def build: (App app, Platform platform, String out, Signing::signer? signing) -> void

      private def build_from: (App app, BuiltApp from, Platform platform, String out, Signing::signer? signing) -> void

      private def written: (Assembly assembly, String out) -> void

      private def out_dir: (App app, String out) -> String

      private def build_project: (App app, MobilePlatform phone, Platform host, String out) -> void

      private def same_ruby: (RuntimeContents contents, Platform | MobilePlatform platform) -> RuntimeContents

      private def minor: (String version) -> String

      private def extensions: (AppGems? gems, MobilePlatform phone, Platform host, Runtimes runtimes, String work, RuntimeContents contents) -> MobileExtensions?

      private def gems_for: (App app, Runtimes runtimes, String work) -> AppGems?

      private def work_folder: [T] () { (String work) -> T } -> T

      private def compiler: (Runtimes runtimes, String work) -> NativeBuild
    end
  end
end
