module Fledge
  class CodeResources
    type rule = Hash[String, bool | Float]

    RULES: Hash[String, true | rule]
    RULES2: Hash[String, true | rule]

    @files: Hash[String, Plist::Bytes | Hash[String, Plist::Bytes | bool]]
    @files2: Hash[String, Hash[String, Plist::Bytes | String | bool]]

    def initialize: () -> void

    def add: (Entry entry) -> void

    def bytes: () -> String

    def self.rule: (Hash[String, true | rule] rules, String path) -> rule?

    private def add_v1: (String path, Entry entry) -> void

    private def with_optional: (Hash[String, Plist::Bytes | String | bool] record, rule rule) -> Hash[String, Plist::Bytes | String | bool]
  end
end
