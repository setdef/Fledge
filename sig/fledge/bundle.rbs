module Fledge
  class Bundle
    WITHOUT: Array[Symbol]
    SETTINGS: String
    GEMSPECS: String

    @app: App
    @lockfile: String
    @definition: Bundler::Definition
    @checksums: Hash[String, String]
    @build_args: Hash[String, Array[String]]

    def initialize: (App app) -> void

    def build_args: (String name) -> Array[String]

    def lockfile_name: () -> String

    private def build_settings: () -> Hash[String, Array[String]]

    private def definition: (String gemfile) -> Bundler::Definition

    private def at_project: [T] (String gemfile) { () -> T } -> T

    private def checksums: (String text) -> Hash[String, String]

    def gems_for: (Platform platform, ruby_version: String, arch: String) -> Array[LockedGem | GitGem]

    private def check_ruby: (String ruby_version) -> void

    private def check_locked: (Platform platform, Gem::Platform target) -> void

    private def chosen: (Platform platform, String ruby_version, Gem::Platform target) -> Array[Bundler::LazySpecification]

    private def best: (Hash[String, Array[Bundler::LazySpecification]] lookup, String name, Gem::Platform target, bool force_ruby, Platform platform) -> Bundler::LazySpecification

    private def ships?: (Bundler::Dependency dependency, Platform platform, String ruby_version) -> bool

    private def on_platform?: (String name, Platform platform, String ruby_version) -> bool

    private def locked_gem: (Bundler::LazySpecification spec, Platform platform) -> (LockedGem | GitGem)?

    private def rubygem: (Bundler::LazySpecification spec, Bundler::Source::Rubygems source, Platform platform) -> LockedGem


    private def git_gem: (Bundler::LazySpecification spec, Bundler::Source::Git source) -> GitGem

    private def own_gem: (Bundler::LazySpecification spec, Bundler::Source::Path source) -> nil

    private def path_gemspec: (String folder, String name) -> Gem::Specification?

    private def inside_project?: (String folder) -> bool

    def app_files: () -> Hash[String, String]

    private def own_folders: () -> Array[String]
  end
end
