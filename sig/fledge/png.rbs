module Fledge
  class Png < Data
    SIGNATURE: String
    CHANNELS: Hash[Integer, Integer]
    DEPTHS: Hash[Integer, Array[Integer]]
    ADAM7: Array[[Integer, Integer, Integer, Integer]]
    MAX_SIDE: Integer

    attr_reader width: Integer
    attr_reader height: Integer
    attr_reader pixels: String

    def self.new: (width: Integer, height: Integer, pixels: String) -> instance

    def self.read: (String bytes) -> Png

    private def self.chunks_of: (String bytes) -> Array[[String, String]]

    private def self.check_header: (Integer width, Integer height, Integer depth, Integer color, Array[Integer] methods) -> void

    private def self.inflate: (String data) -> String

    def encode: () -> String

    private def chunk: (String type, String data) -> String

    class Decoder
      @width: Integer
      @height: Integer
      @depth: Integer
      @color: Integer
      @interlace: Integer
      @channels: Integer
      @palette: String?
      @transparency: String?
      @palette_table: Array[String]

      def initialize: (width: Integer, height: Integer, depth: Integer, color: Integer, interlace: Integer, chunks: Array[[String, String]]) -> void

      def decode: (String raw) -> Png

      private def decode_rows: (String raw) -> String

      private def chunk: (Array[[String, String]] chunks, String type) -> String?

      private def each_line: (String raw, Integer at, Integer columns, Integer rows) { (Array[Integer], Integer) -> void } -> Integer

      private def unfilter: (Integer filter, Array[Integer] line, Array[Integer] previous, Integer step) -> void

      private def left: (Array[Integer] line, Integer index, Integer step) -> Integer

      private def paeth: (Integer left, Integer up, Integer up_left) -> Integer

      private def rgba_row: (Array[Integer] line, Integer columns) -> String

      private def palette_table: () -> Array[String]

      private def samples: (Array[Integer] line, Integer columns) -> Array[Array[Integer]]

      private def rgba: (Array[Integer] sample) -> Array[Integer]

      private def gray: (Integer level, Integer alpha) -> Array[Integer]

      private def scale: (Integer value) -> Integer

      private def transparent?: (Array[Integer] sample) -> bool

      private def palette_color: (Integer index) -> Array[Integer]
    end
  end
end
