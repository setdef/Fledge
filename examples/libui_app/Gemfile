source "https://rubygems.org"

# LibUI, kojix2's binding of libui-ng through Fiddle. Its builds for
# arm64-darwin, x86_64-linux, aarch64-linux, and x64-mingw-ucrt carry
# libui-ng's shared library in their vendor folder, which LibUI opens
# when it is required; Gemfile.lock names those four platforms only,
# since on any other the gem has no library to open.
gem "libui", "0.2.5"
