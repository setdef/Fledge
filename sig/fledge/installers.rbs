module Fledge
  module Installers
    type writer = Dmg | Nsis | AppImage

    OS: Hash[String, String]
    SUFFIX: Hash[String, String]

    def self.formats: (App app, Platform platform) -> Array[String]

    def self.file_name: (String format, String base) -> String

    def self.writer: (String format, app: App, folder: String, makensis: String?, ?mtime: Integer) -> writer
  end
end
