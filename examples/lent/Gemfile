source "https://rubygems.org"

# The three parts of Rails that Lent uses, not the rails gem, which
# would bring the rest: Action Cable, Active Storage, mailers, and jobs.
gem "actionpack", "~> 8.1.0"
gem "actionview", "~> 8.1.0"
gem "activerecord", "~> 8.1.0"
gem "railties", "~> 8.1.0"
gem "sqlite3", "~> 2.1"

# Tokra, the window and its web view, and ferro-url, its one dependency,
# are published on GitHub's releases and on no gem server, so Bundler
# reads them from vendor/cache, which bin/fetch-gems fills from those
# releases, each file checked against the SHA-256 that Gemfile.lock's
# CHECKSUMS holds for it (doc/gems.md, "A gem that only vendor/cache
# holds"). Gemfile.lock names their builds for arm64-darwin,
# x86_64-linux-gnu, and x64-mingw-ucrt, which carry Tokra's compiled
# library. Tokra is under the AGPL-3.0-or-later.
gem "tokra", "0.0.2"
gem "ferro-url", "0.1.2"

# Ruby's time zones, which Rails needs and Windows does not have.
gem "tzinfo-data", platforms: :windows

# railties brings erb, through irb and rdoc, and Ruby 4.1.0-preview1's
# own erb, 6.1.0, is on no gem server, so Gemfile.lock could hold no
# checksum for it, and fledge build would refuse it. This locks a
# released erb instead.
gem "erb", "~> 6.0.7"
