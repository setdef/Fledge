<header>
  <h1>Lent</h1>
  <%= link_to "Lend something", new_loan_path, class: "button" %>
</header>

<% if @out.empty? %>
  <p class="empty">Nothing is out. When you lend something, add it here.</p>
<% else %>
  <h2><%= pluralize(@out.size, "thing") %> out</h2>
  <ul class="loans">
    <% @out.each do |loan| %>
      <li>
        <div>
          <strong><%= loan.thing %></strong> with <%= loan.borrower %>
          <span class="since">
            <%= loan.days_out.zero? ? "since today" : "#{pluralize(loan.days_out, 'day')}, since #{l(loan.lent_on, format: :long)}" %>
          </span>
          <% if loan.note.present? %><p class="note"><%= loan.note %></p><% end %>
        </div>
        <div class="actions">
          <%= button_to "It came back", return_loan_path(loan), method: :patch %>
          <%= link_to "Edit", edit_loan_path(loan) %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @back.any? %>
  <h2>Came back</h2>
  <ul class="loans back">
    <% @back.each do |loan| %>
      <li>
        <div><%= loan.thing %> from <%= loan.borrower %>, <%= l(loan.returned_on, format: :long) %></div>
        <%= button_to "Forget", loan_path(loan), method: :delete %>
      </li>
    <% end %>
  </ul>
<% end %>
