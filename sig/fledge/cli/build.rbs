module Fledge
  class CLI
    class Build
      DEFAULT_OUT: String

      @out: CLI::_Output
      @err: CLI::_Output
      @env: Runtimes::_Env
      @host: Gem::Platform
      @makensis: String?

      def initialize: (out: CLI::_Output, err: CLI::_Output, ?env: Runtimes::_Env, ?host: Gem::Platform) -> void

      def call: (Array[String]) -> Integer

      private def build: (App app, Array[Platform] platforms, String out) -> void

      private def gems_for: (App app, Runtimes runtimes, String work) -> AppGems?

      private def makensis: (Runtimes runtimes) -> String

      private def compiler: (Runtimes runtimes, String work) -> NativeBuild?

      private def parse: (Array[String] argv) -> [Array[String], String, String]

      private def value_of: (String option, Array[String] arguments, String name) -> String
    end
  end
end
