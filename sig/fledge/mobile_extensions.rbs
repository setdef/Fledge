# SPDX-License-Identifier: MIT

module Fledge
  class MobileExtensions
    FOREIGN: Array[String]
    INSTALL_XCODE: String
    TOOLS: String
    SHIM: String

    class TargetBuild < Data
      attr_reader target: Target
      attr_reader archives: Array[String]
      attr_reader flags: Array[String]
      attr_reader cxx: bool

      def self.new: (target: Target, archives: Array[String], flags: Array[String], cxx: bool) -> instance
                  | (Target target, Array[String] archives, Array[String] flags, bool cxx) -> instance
    end

    class Report < Data
      attr_reader feature: String
      attr_reader init: String
      attr_reader archive: String
      attr_reader flags: Array[String]
      attr_reader cxx: bool

      def self.new: (feature: String, init: String, archive: String, flags: Array[String], cxx: bool) -> instance
                  | (String feature, String init, String archive, Array[String] flags, bool cxx) -> instance
    end

    class Built < Data
      attr_reader registrations: Array[[String, String]]
      attr_reader targets: Hash[String, TargetBuild]
      attr_reader ndk: NDK?
      attr_reader stubs: Array[Entry]

      def self.new: (registrations: Array[[String, String]], targets: Hash[String, TargetBuild], ndk: NDK?, stubs: Array[Entry]) -> instance
                  | (Array[[String, String]] registrations, Hash[String, TargetBuild] targets, NDK? ndk, Array[Entry] stubs) -> instance
    end

    @platform: MobilePlatform
    @packages: Hash[locked_gem, package]
    @build_args: Hash[String, Array[String]]
    @host: Platform
    @runtimes: Runtimes
    @work: String
    @runner: Runner
    @env: Runtimes::_Env
    @gem_dir: String
    @ruby: String?
    @rake_build: RakeBuild?
    @extconf_build: ExtconfBuild?
    @dependencies: Hash[locked_gem, package]
    @load_path: Array[String]?
    @stubs: Hash[String, Entry]

    def self.problems: (locked_gem gem, package package, MobilePlatform platform, Platform host) -> Array[String]

    def self.rake?: (String path) -> bool

    def self.registration_source: (Array[[String, String]] registrations) -> String

    private def self.c_string: (String text) -> String

    def initialize: (platform: MobilePlatform, packages: Hash[locked_gem, package], build_args: Hash[String, Array[String]], host: Platform, runtimes: Runtimes, work: String, log: CLI::_Output, gem_dir: String, ?env: Runtimes::_Env, ?dependencies: Hash[locked_gem, package]) -> void

    def call: (String tree) -> Built

    def shared_library: (Built built, TargetBuild build, registration: String, into: String) -> String

    private def compile_target: (Target target) -> Array[Report]

    private def same_registrations: (Array[[String, String]] registrations, Array[Report] reports) -> Array[[String, String]]

    private def refuse_clash: (Array[[String, String]] registrations) -> void

    private def compile: (Target target, locked_gem gem, package package, Array[String] args, Integer first) -> Array[Report]

    private def extconf: (Target target, locked_gem gem, package package, String root, String extension, Array[String] args, Integer number) -> Report

    private def extconf_build: () -> ExtconfBuild

    private def rake_build: () -> RakeBuild

    private def load_path: () -> Array[String]

    private def ruby: () -> String
  end
end
