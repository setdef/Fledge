module Fledge
  class GemFetcher
    @cache: String
    @project: String
    @gem_path: Array[String]
    @log: CLI::_Output?

    def initialize: (cache: String, project: String, ?gem_path: Array[String], ?log: CLI::_Output?) -> void

    def fetch: (LockedGem gem) -> String

    private def candidates: (LockedGem gem, String cached) -> Array[String]
  end
end
