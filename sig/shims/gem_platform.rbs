module Gem
  class Platform
    def self.local: () -> Gem::Platform

    def self.new: (String) -> Gem::Platform

    RUBY: String

    def self.generic: (Gem::Platform platform) -> Gem::Platform

    def ===: (Gem::Platform other) -> bool?

    attr_accessor cpu: String?
    attr_accessor os: String
    attr_accessor version: String?
  end
end
