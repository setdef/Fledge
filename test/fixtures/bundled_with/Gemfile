# An app whose Gemfile.lock was written by Bundler 4.0.19, which no
# runtime's Ruby ships as its own: bundle exec runs it with Bundler
# 4.0.19, which bundle install installs, and so must the built app (ADR
# 063).
source "https://rubygems.org"

gem "concurrent-ruby", "~> 1.3"
