module Bundler
  def self.settings: () -> Settings

  def self.reset_settings_and_root!: () -> void

  def self.load_gemspec: (String file) -> Gem::Specification?

  def self.app_cache: (?String? custom_path) -> Pathname

  class BundlerError < StandardError
  end

  class GemfileError < BundlerError
  end

  class Settings
    def temporary: [T] (Hash[Symbol, bool | Array[String]] update) { () -> T } -> T

    def all: () -> Array[String]

    def app_cache_path: () -> String

    def []: (:with | :without | :only) -> Array[Symbol]
         | (String | Symbol name) -> (String | bool | Integer)?
  end

  class Dsl
    def initialize: () -> void

    def eval_gemfile: (String gemfile, ?String contents) -> void

    def lockfile: (String file) -> void

    def lockfile_path: () -> String?

    def group: (*Symbol groups, ?optional: bool) { () -> void } -> void

    def dependencies: () -> Array[Dependency]

    def dependencies=: (Array[Dependency] dependencies) -> Array[Dependency]

    def to_definition: (Pathname lockfile, Hash[Symbol, bool] unlock) -> Definition
  end

  class Definition
    def ensure_equivalent_gemfile_and_lockfile: (bool explicit_flag) -> void

    def ruby_version: () -> RubyVersion?

    def platforms: () -> Array[Gem::Platform]

    def locked_gems: () -> LockfileParser

    def dependencies: () -> Array[Dependency]

    def add_platform: (Gem::Platform platform) -> void

    def to_lock: () -> String

    private def requested_groups: () -> Array[Symbol]
  end

  class LockfileParser
    def initialize: (String lockfile) -> void

    def sources: () -> Array[Source]

    def specs: () -> Array[LazySpecification]
  end

  class LazySpecification
    def name: () -> String

    def version: () -> Gem::Version

    def platform: () -> (Gem::Platform | String)

    def source: () -> Source

    def dependencies: () -> Array[Gem::Dependency]
  end

  class SourceList
    def global_rubygems_source: () -> Source::Rubygems

    def non_global_rubygems_sources: () -> Array[Source::Rubygems]

    def path_sources: () -> Array[Source::Path]

    def git_sources: () -> Array[Source::Git]

    def plugin_sources: () -> Array[Source]

    def add_rubygems_source: (Hash[String, Array[String]] options) -> Source::Rubygems

    def add_path_source: (Hash[String, Object?] options) -> Source::Path

    def add_git_source: (Hash[String, Object?] options) -> Source::Git
  end

  class Dependency < Gem::Dependency
    def initialize: (String name, Array[String] version, Hash[String, Object?] options) -> void

    def groups: () -> Array[Symbol]

    def platforms: () -> Array[Symbol]

    def should_include: () -> bool

    def current_env?: () -> bool

    def force_ruby_platform: () -> bool?
  end

  class RubyVersion
    def initialize: (Array[String] versions, String? patchlevel, String? engine, String | Array[String] engine_version) -> void

    def engine: () -> String

    def engine_versions: () -> Array[String]

    def diff: (RubyVersion other) -> Array[Symbol | String]?

    def versions: () -> Array[String]

    def patchlevel: () -> Object?
  end

  module MatchPlatform
    def self.select_best_platform_match: (Array[LazySpecification] specs, Gem::Platform | String platform, ?force_ruby: bool) -> Array[LazySpecification]
  end

  class Source
    class Rubygems < Source
      def remotes: () -> Array[URI::Generic]

      def remote_cooldowns: () -> Hash[URI::Generic, Integer]

      def add_remote: (String uri) -> void

      class Remote
        def initialize: (URI::Generic | String uri) -> void

        def uri: () -> URI::Generic

        def anonymized_uri: () -> URI::Generic
      end
    end

    class Path < Source
      def path: () -> Pathname

      def options: () -> Hash[String, String]
    end

    class Git < Path
      def uri: () -> String

      def options: () -> Hash[String, String]

      def glob: () -> String

      def submodules: () -> bool?
    end
  end
end
