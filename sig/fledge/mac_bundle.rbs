module Fledge
  class MacBundle
    LINKED: Array[String]
    INSTALL: String

    @identity: Identity
    @folder: String
    @build: String?

    def self.for: (Identity identity, platform: Platform, folder: String, ?build: String?) -> MacBundle?

    def initialize: (Identity identity, folder: String, ?build: String?) -> void

    def path: () -> String

    def resources: () -> String

    def info: () -> Hash[String, String | bool | Array[Hash[String, String | Array[String]]]]

    def self.document_type: (Config::FileAssociation association) -> Hash[String, String | Array[String]]

    def self.bundle_version: (String version) -> String

    def executables: () -> String

    def finish: (String launcher, ?helpers: Array[String], ?signing: MacSigning?) -> String

    private def write_info_plist: () -> String

    private def icon_file: () -> String
  end
end
