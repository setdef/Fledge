module Fledge
  class RuntimeContents < Data
    SPECIFICATION: Regexp
    RBCONFIG: Regexp
    VERSION_PARTS: Regexp
    LIBRARY: Regexp
    ARCH: Regexp
    SHARED: Regexp
    PLUGIN: Regexp
    DESCRIPTION: String

    attr_reader gem_dir: String
    attr_reader gems: Array[String]
    attr_reader ruby_version: String
    attr_reader patchlevel: String
    attr_reader libraries: Array[String]
    attr_reader arch: String
    attr_reader path: String
    attr_reader plugins: Array[String]
    attr_reader binaries: Array[String]
    attr_reader extension_api: String

    def self.new: (gem_dir: String, gems: Array[String], ruby_version: String, patchlevel: String, libraries: Array[String], arch: String, path: String, plugins: Array[String], binaries: Array[String], extension_api: String) -> instance

    def self.read: (String path, ?under: String) -> RuntimeContents

    def bin_dir: () -> String

    def tool: (String name, into: String) -> String?

    private def self.ruby_version_in: (String rbconfig, String? description) -> String?

    private def self.searched?: (String path, String bin_dir, String archdir) -> bool

    private def self.build: (String path, Array[String] gem_dirs, Array[String] gems, String? version) -> RuntimeContents
  end
end
