# A path gem whose extconf.rb builds a C++ library with CMake (ADR 027).
# fledge build ios and fledge build android run that extconf.rb for each
# phone's targets, and CMake builds the library for each of them.
source "https://rubygems.org"

gem "tally", path: "gems/tally"
