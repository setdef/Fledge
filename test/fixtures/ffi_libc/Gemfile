# ffi alone, which every ffi gem of an app depends on. Its precompiled
# builds exclude Ruby 4.1, so it compiles from source, with the libffi
# it carries, which on Alpine needs the kernel's headers (linux-headers).
source "https://rubygems.org"

gem "ffi", "1.17.4"
