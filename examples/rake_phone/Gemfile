# digest-crc, whose gemspec names a Rakefile, not an extconf.rb: the
# Rakefile runs an extconf.rb and make for each of its CRCs. fledge build
# ios and fledge build android run it with RubyGems' own builder, aimed
# at each of the phone's targets.
source "https://rubygems.org"

gem "digest-crc", "0.7.0"
