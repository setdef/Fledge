module Fledge
  module LicensePolicy
    type category = :notice_only | :file_level | :source_offer | :shared_library | :forbidden

    NOTICE_ONLY: Array[String]
    FILE_LEVEL: Array[String]
    SHARED_LIBRARY: Array[String]
    SOURCE_OFFER: Array[String]
    EXCEPTIONS: Array[String]
    ALIASES: Hash[String, String]
    CATEGORIES: Array[category]

    def self.category: (String expression) -> category

    def self.notice_only?: (String expression) -> bool

    def self.gem_license: (Array[String] licenses) -> String

    class Expression
      @tokens: Array[String]

      def initialize: (String text) -> void

      def category: () -> category

      private def disjunction: () -> category

      private def conjunction: () -> category

      private def operands: (String operator) { () -> category } -> Array[category]

      private def rank: (category category) -> Integer

      private def exception: () -> category

      private def atom: () -> category

      private def classify: (String id) -> category
    end
  end
end
