module Fledge
  module Download
    REDIRECTS: Integer
    WAITS: Array[Integer]

    class Unsuccessful < Error
      attr_reader status: Integer

      def initialize: (String message, Integer status) -> void
    end

    class Refused < Unsuccessful
    end

    class Missing < Unsuccessful
    end

    class Unavailable < Unsuccessful
    end

    class Unreachable < Error
    end

    class Mismatch < Error
      attr_reader actual: String

      attr_reader expected: String

      def initialize: (String message, actual: String, expected: String) -> void
    end

    def self.read: (String url) -> String

    def self.save: (String url, to: String, sha256: String, ?credentials: String?, ?waits: Array[Integer], ?log: CLI::_Output?) -> String

    private def self.stream: (String url, String partial, String? credentials) -> String

    private def self.again: [T] (Array[Integer] waits, CLI::_Output? log) { () -> T } -> T

    private def self.verify: (String url, String actual, String expected) -> void

    private def self.get: (String url, ?Integer redirects, ?credentials: String?) { (Net::HTTPResponse) -> void } -> void

    private def self.status_error: (String url, Net::HTTPResponse response) -> Unsuccessful

    private def self.follow: (URI::Generic from, String location, Integer redirects, String? credentials) { (Net::HTTPResponse) -> void } -> void

    private def self.login: (String credentials) -> [String, String]
  end
end
