Fledge's changes to AppImage's type 2 runtime (ADR 009), applied to
src/runtime/runtime.c of AppImage/type2-runtime at
fedfad51acc2860b2916a1eef32ba4a500ff31ef, as runtime/sources.yml pins it,
by tasks/runtime_builder.rb with patch -p1.

Fledge links no libfuse into the runtime: it loads the computer's own
(runtime/appimage/fuse.c). So the runtime extracts and runs the AppImage
when that libfuse, or /dev/fuse, is missing, and when mounting fails,
instead of printing that FUSE is missing; and it leaves finding
fusermount3 to that libfuse, as libfuse does itself.

The lines of runtime.c this patch shows are AppImage's, under the MIT
license (Copyright (c) 2004-24 Simon Peter); the lines it adds are
Fledge's. REUSE.toml records both.

--- a/src/runtime/runtime.c
+++ b/src/runtime/runtime.c
@@ -64,6 +64,9 @@
 #include <libgen.h>
 #include <dirent.h>
 #include <ctype.h>
+
+/* Fledge: the computer's own libfuse, loaded only to mount (fuse.c). */
+extern bool fledge_fuse_usable(void);
 
 const char* fusermountPath = NULL;
 
@@ -1577,7 +1580,12 @@
         free(abspath);
     }
 
-    if (getenv("APPIMAGE_EXTRACT_AND_RUN") != NULL || (arg && strcmp(arg, "appimage-extract-and-run") == 0)) {
+    /* Fledge: with no FUSE to mount with, or after a mount that failed,
+     * extract and run instead. */
+    const bool fledge_extract = getenv("FLEDGE_APPIMAGE_EXTRACT") != NULL;
+    unsetenv("FLEDGE_APPIMAGE_EXTRACT");
+    if (fledge_extract || getenv("APPIMAGE_EXTRACT_AND_RUN") != NULL || (arg && strcmp(arg, "appimage-extract-and-run") == 0) ||
+        (!(arg && strncmp(arg, "appimage-", 9) == 0) && !fledge_fuse_usable())) {
         char* hexlified_digest = NULL;
 
         // calculate MD5 hash of file, and use it to make extracted directory name "content-aware"
@@ -1737,19 +1745,7 @@
     if (pid == 0) {
         /* in child */
 
-        fusermountPath = getenv("FUSERMOUNT_PROG");
-        if (fusermountPath == NULL) {
-            char* new_prog = find_fusermount(verbose);
-            if (new_prog != NULL) {
-                setenv("FUSERMOUNT_PROG", new_prog, 1);
-                if (verbose) {
-                    fprintf(stderr, "FUSERMOUNT_PROG set to %s\n", new_prog);
-                }
-                free(new_prog);
-            } else {
-                printf("Error: No suitable fusermount binary found on the $PATH\n");
-            }
-        }
+        /* Fledge: the computer's libfuse finds its own fusermount3. */
 
         char* child_argv[5];
 
@@ -1767,17 +1763,11 @@
         child_argv[3] = dir;
         child_argv[4] = mount_dir;
 
-        if (0 != fusefs_main(5, child_argv, fuse_mounted)) {
-            char* title;
-            char* body;
-            title = "Cannot mount AppImage, please check your FUSE setup.";
-            body = "You might still be able to extract the contents of this AppImage \n"
-                   "if you run it with the --appimage-extract option. \n"
-                   "See https://github.com/AppImage/AppImageKit/wiki/FUSE \n"
-                   "for more information";
-            printf("\n%s\n", title);
-            printf("%s\n", body);
-        };
+        /* Fledge: a mount that fails says nothing; the parent extracts
+         * and runs instead. */
+        if (!fledge_fuse_usable() || 0 != fusefs_main(5, child_argv, fuse_mounted)) {
+            exit(EXIT_EXECERROR);
+        }
     } else {
         /* in parent, child is $pid */
         int c;
@@ -1786,7 +1776,19 @@
         close(keepalive_pipe[1]);
 
         /* Pause until mounted */
-        read(keepalive_pipe[0], &c, 1);
+        if (read(keepalive_pipe[0], &c, 1) != 1) {
+            /* Fledge: the mount failed, so start again, extracting. */
+            waitpid(pid, NULL, 0);
+            rmdir(mount_dir);
+            if (arg && strcmp(arg, "appimage-mount") == 0) {
+                fprintf(stderr, "Cannot mount AppImage, please check your FUSE setup.\n");
+                exit(EXIT_EXECERROR);
+            }
+            setenv("FLEDGE_APPIMAGE_EXTRACT", "1", 1);
+            execv("/proc/self/exe", argv);
+            perror("execv error");
+            exit(EXIT_EXECERROR);
+        }
 
         /* Fuse process has now daemonized, reap our child */
         waitpid(pid, NULL, 0);
