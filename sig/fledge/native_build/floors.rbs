module Fledge
  class NativeBuild
    module Floors
      def self.problems: (locked_gem gem, Array[Entry] entries, Platform platform, ?readers: Binary::Readers) -> Array[String]

      COMPILED_ADVICE: String

      PRECOMPILED_ADVICE: String

      def self.warnings: (locked_gem gem, Array[Entry] entries, Platform platform, ?precompiled: bool, ?readers: Binary::Readers) -> Array[String]

      def self.glibc: (Array[Entry] entries, Platform platform, ?floor: String?, ?readers: Binary::Readers) -> String?

      private def self.needing: (Symbol format, Array[Entry] entries, Platform platform, Binary::Readers readers) { (Binary) -> String? } -> Array[[String, String]]

      private def self.newer?: (String found, String floor) -> bool
    end
  end
end
