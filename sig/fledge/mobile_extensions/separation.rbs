module Fledge
  class MobileExtensions
    class Separation
      class Owner
        attr_reader what: String
        attr_reader names: Array[String]
        attr_reader keep: Array[String]

        def self.new: (what: String, names: Array[String], keep: Array[String]) -> Owner
      end

      @runner: Runner
      @work: String

      def self.local_names: (Array[Owner] objects, Array[Owner] fixed) -> Array[Array[String]]

      def initialize: (runner: Runner, work: String) -> void

      def call: (Target target, Array[Report] reports, gems: Hash[String, String]) -> Array[Report]

      private def shared_libraries: (Array[Report] reports) -> Hash[String, Array[Report]]

      private def private_libraries: (Report report, Hash[String, Array[Report]] shared) -> Array[String]

      private def prelink: (Tools tools, Report report, Hash[String, Array[Report]] shared, String folder, Hash[String, String] gems) -> [Owner, String]

      private def gem_words: (Report report, Hash[String, String] gems) -> String

      class Tools
        @target: Target
        @runner: Runner

        def self.for: (Target target, Runner runner) -> Tools

        def initialize: (Target target, Runner runner) -> void

        def runtime: () -> Owner?

        def names: (String path) -> Array[String]

        def prelink: (String init, Array[String] inputs, String out) -> void

        def localize: (String object, Array[String] names, String archive) -> String

        private def compiler: () -> Array[String]

        private def prelink_flags: (String init) -> Array[String]

        private def symbol: (String name) -> String

        private def localizer: (String list, String object, String edited) -> Array[String]

        private def archiver: () -> Array[String]

        private def capture: (*String command) -> String

        class Apple < Tools
          def runtime: () -> Owner?

          def names: (String path) -> Array[String]

          private def prelink_flags: (String init) -> Array[String]

          private def symbol: (String name) -> String

          private def localizer: (String list, String object, String edited) -> Array[String]

          private def archiver: () -> Array[String]
        end

        class Android < Tools
          def names: (String path) -> Array[String]

          private def prelink_flags: (String init) -> Array[String]

          private def localizer: (String list, String object, String edited) -> Array[String]

          private def archiver: () -> Array[String]

          private def tool: (String name) -> String
        end
      end
    end
  end
end
