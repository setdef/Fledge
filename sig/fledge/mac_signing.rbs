module Fledge
  class MacSigning
    ENTITLEMENTS: String
    INSTALL: String
    TIMESTAMP_FAILURES: Array[String]
    WAITS: Array[Integer]

    @identity: String
    @waits: Array[Integer]
    @notary: Notary?

    attr_reader identity: String

    attr_reader notary: Notary?

    def initialize: (String identity, ?waits: Array[Integer], ?notary: Notary?) -> void

    def code_options: () -> Array[String]

    def sign_folder: (String folder) -> void

    def self.object_file?: (String path) -> bool

    def sign_bundle: (String path, identifier: String, ?helpers: Array[String]) -> String

    def sign_image: (String path) -> String

    private def codesign: (*String arguments) -> String

    private def timestamp: () -> Array[String]
  end
end
