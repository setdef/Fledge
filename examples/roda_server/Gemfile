source "https://rubygems.org"

# Roda routes the requests, on Rack, which every Ruby server speaks, and
# WEBrick serves them, through rackup's handler. All four are plain Ruby,
# so nothing compiles, on any system Fledge builds for.
gem "rackup", "2.3.1"
gem "roda", "3.110.0"
gem "webrick", "1.9.2"
