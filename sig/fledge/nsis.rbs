module Fledge
  class Nsis
    UNINSTALL_KEY: String
    UNINSTALLER: String

    @identity: Identity
    @folder: String
    @to: String
    @makensis: String

    def initialize: (identity: Identity, folder: String, to: String, makensis: String) -> void

    def script: (icon: String?) -> String

    def write: (String? tools) -> String

    def self.host_path: (String path) -> String

    private def compile: (String script_path, String nsis) -> void
  end
end
