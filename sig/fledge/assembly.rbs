module Fledge
  class Assembly
    LAUNCHER: String
    WINDOWED_LAUNCHER: String
    CONFIG: String

    @app: App
    @platform: Platform
    @runtime: String
    @out: String
    @app_files: Hash[String, String]
    @files: Array[Entry]
    @placed: Hash[String, bool]
    @bundle: MacBundle?

    def initialize: (app: App, platform: Platform, runtime: String, out: String, ?app_files: Hash[String, String], ?files: Array[Entry]) -> void

    def base_name: () -> String

    def call: () -> String

    def launch_config: () -> String

    private def config_value: (String path) -> String

    private def build: () -> String

    private def finish: (TarGz::Writer | Zip::Writer writer, Entry launcher) -> void

    private def windows_program: (String content, String executable) -> String

    private def launcher_name: () -> String

    private def folder: () -> String

    private def archive: () -> String

    private def remove_output: () -> void

    private def copy_runtime: (TarGz::Writer | Zip::Writer writer) -> Entry

    private def runtime_path: (String path) -> String

    private def copy_app: (TarGz::Writer | Zip::Writer writer) -> void

    private def add: (TarGz::Writer | Zip::Writer writer, Entry entry) -> void

    private def put: (TarGz::Writer | Zip::Writer writer, Entry entry) -> void

    private def place: (TarGz::Writer | Zip::Writer writer, Entry entry) -> void
  end
end
