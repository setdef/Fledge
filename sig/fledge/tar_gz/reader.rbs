module Fledge
  module TarGz
    class Reader
      @io: _Source

      def initialize: (_Source io) -> void

      def each: () { (Entry) -> void } -> void

      private def read_block: () -> String?

      private def verify_checksum: (String block) -> void

      private def number: (String block, Integer offset, Integer length) -> Integer

      private def read_padded: (Integer size) -> String

      private def pax: (String data) -> Hash[String, String]

      private def entry: (String block, String typeflag, String data, Hash[String, String] overrides) -> Entry

      private def ustar_name: (String block) -> String

      private def field: (String block, Integer offset, Integer length) -> String

      private def utf8: (String bytes) -> String
    end
  end
end
