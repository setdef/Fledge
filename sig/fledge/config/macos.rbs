module Fledge
  class Config
    class Macos < Data
      KEYS: Array[String]
      LIBRARY: Regexp
      BUILD: Regexp

      attr_reader build: String?
      attr_reader carried_libraries: Array[String]

      def self.new: (build: String?, carried_libraries: Array[String]) -> instance

      def self.from: (Hash[Object, Object] data, String file) -> Macos?

      private def self.libraries: (Object value, String file) -> Array[String]

      private def self.build: (Object value, String file) -> String?
    end
  end
end
