module Fledge
  class GemPackage
    @files: Array[Entry]

    attr_reader spec: Gem::Specification
    attr_reader path: String

    def self.ruby_problems: (Gem::Specification spec, String ruby_version) -> Array[String]

    def initialize: (String path) -> void

    def problems: (ruby_version: String) -> Array[String]

    def extensions?: () -> bool

    def installed_path: (String gem_dir) -> String

    def entries: (String gem_dir) -> Array[Entry]

    def contents: () -> Hash[String, String]


    private def specification: () -> String

    private def plugins: (String gem_dir, String installed) -> Array[Entry]

    private def data_files: () -> Array[Entry]

    private def entry_of: (Gem::Package::TarReader::Entry entry) -> Entry?
  end
end
