module Fledge
  class MobileProject
    class Android < MobileProject
      AGP: String
      APPLICATION_ID: Regexp
      VERSION_CODE_MAX: Integer
      AAR: String
      EXTENSIONS: String
      RUNTIME_EXTENSION: String
      COMMANDS: String
      PROGRAM: String
      ABI_FILES: String
      FILES: String

      def self.version_code: (String version) -> Integer

      def self.ruby_under: () -> String

      private def system: () -> String

      private def template_files: () -> Array[String]

      private def tokens: () -> Hash[String, String]

      private def application_id: () -> String

      private def groovy: (String text) -> String

      private def string_resource: (String text) -> String

      private def place_runtime: (String tree, String project) -> void
      private def place_commands: (String root) -> void
      private def place_apart: (String root) -> void

      private def place_extensions: (String project) -> void

      private def ruby_root: (String project) -> String

      private def place_icons: (String project) -> void

      private def finish: (String project) -> void

      private def packaging_problem: (String project) -> String?

      private def runtime_extensions?: (String project) -> bool

      private def readers: () -> Binary::Readers
    end
  end
end
