module Fledge
  class Assembly
    class RuntimeFolder
      @path: String
      @platform: Platform
      @app_names: Array[String]
      @top: String

      def initialize: (String path, platform: Platform, app_names: Array[String], work: String, ?only: Array[String]) -> void

      private def members: (Array[String] only) -> Array[String]

      def launcher: (String name) -> String

      def tools: () -> String?

      def move_into: (String folder) -> void

      private def held: () -> Array[String]

      private def check: (String name) -> void
    end
  end
end
