module Fledge
  class Squashfs
    class Metadata
      @disk: String
      @pending: String

      def initialize: () -> void

      def position: () -> [Integer, Integer]

      def reference: () -> Integer

      def <<: (String bytes) -> self

      def bytes: () -> String

      private def flush: (String block) -> void
    end
  end
end
