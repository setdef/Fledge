module Fledge
  class Assembly
    LAUNCHER: String
    WINDOWED_LAUNCHER: String
    INSTALLER: String
    CONFIG: String

    @app: App
    @platform: Platform
    @runtime: String
    @out: String
    @app_files: Hash[String, String]
    @files: Array[Entry]
    @bundle: MacBundle?
    @makensis: String?
    @writers: Array[Installers::writer]
    @kit: Hash[String, Entry]
    @installers: Array[String]

    attr_reader installers: Array[String]

    def initialize: (app: App, platform: Platform, runtime: String, out: String, ?app_files: Hash[String, String], ?files: Array[Entry], ?makensis: String?) -> void

    def base_name: () -> String

    def call: () -> String

    def launch_config: () -> String

    private def config_value: (String path) -> String

    private def build: () -> String

    private def finish: (Placement placement, Entry launcher) -> void

    private def windows_program: (String content, String executable) -> String

    private def launcher_name: () -> String

    private def folder: () -> String

    private def archive: () -> String

    private def remove_output: () -> void

    private def copy_runtime: (Placement placement) -> Entry

    private def copy_app: (Placement placement) -> void
  end
end
