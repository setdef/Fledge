module Fledge
  class Linkage
    SYSTEM_LIBRARIES: Hash[String, Array[Regexp]]
    WINDOWS_DLLS: String
    SYSTEM_DLLS: Hash[String, Set[String]]
    VISUAL_C_RUNTIME: Regexp
    RUBY_DLL: Regexp
    FORMATS: Hash[String, Symbol]

    @system: Array[Regexp]
    @dlls: Set[String]
    @os: String
    @cpu: String?
    @provided: Array[String]
    @declared: Array[String]
    @carried: Array[String]
    @needed: Array[String]
    @readers: Binary::Readers
    @visual_c_runtime: String?
    @visual_c: Array[String]

    def initialize: (os: String, ?cpu: String?, ?provided: Array[String], ?system: Array[String], ?readers: Binary::Readers, ?visual_c_runtime: String?, ?carried: Array[String]) -> void

    def visual_c_libraries: () -> Array[String]

    def problems: (String label, Hash[String, String] files) -> Array[String]

    def unused: () -> Array[String]

    private def loaded_by_name?: (String library, Array[String] loaded) -> bool

    private def native?: (Binary binary) -> bool

    private def system?: (String library) -> bool

    private def unprovided: (String label, String path, String library) -> String?

    private def visual_c: (String label, String path, String library) -> String?

    private def unreached: (String label, String path, String library, Dyld dyld, Array[String] paths) -> String?

    private def loader_path: (String path, String target) -> String
  end
end
