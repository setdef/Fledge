module Fledge
  class CLI
    class Build
      DEFAULT_OUT: String

      @out: CLI::_Output
      @err: CLI::_Output
      @env: Runtimes::_Env
      @host: Gem::Platform

      def initialize: (out: CLI::_Output, err: CLI::_Output, ?env: Runtimes::_Env, ?host: Gem::Platform) -> void

      def call: (Array[String]) -> Integer

      private def build: (App app, Platform platform, String out) -> void

      private def gems_for: (App app, Runtimes runtimes, String work) -> AppGems?

      private def compiler: (Runtimes runtimes, String work) -> NativeBuild
    end
  end
end
