module Fledge
  class Nsis
    UNINSTALL_KEY: String
    UNINSTALLER: String
    MAKENSIS: String
    BOM: String

    @identity: Identity
    @folder: String
    @to: String
    @signing: (WindowsSigning | SignCommand)?
    @license: String?

    def initialize: (identity: Identity, folder: String, to: String, ?signing: (WindowsSigning | SignCommand)?, ?license: String?) -> void

    def script: (icon: String?, ?license: String?) -> String

    def self.license_text: (String text) -> String

    def write: (String? tools) -> String

    def self.host_path: (String path) -> String

    private def compile: (String script_path, String nsis) -> void

    private def signing_failure: (String output) -> String
  end
end
