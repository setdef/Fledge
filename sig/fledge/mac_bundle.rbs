module Fledge
  class MacBundle
    LINKED: Array[String]
    INSTALL: String

    @identity: Identity
    @folder: String

    def initialize: (Identity identity, folder: String) -> void

    def path: () -> String

    def resources: () -> String

    def info: () -> Hash[String, String | bool]

    def self.bundle_version: (String version) -> String

    def finish: (String launcher) -> String

    private def write_info_plist: () -> String

    private def icon_file: () -> String
  end
end
