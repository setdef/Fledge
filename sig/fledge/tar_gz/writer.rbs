module Fledge
  module TarGz
    class Writer
      @io: _Sink
      @mtime: Integer

      def initialize: (_Sink io, mtime: Integer) -> void

      def add: (Entry entry) -> void

      def finish: () -> void

      private def write_pax: (String name, String link) -> void

      private def pax_record: (String key, String value) -> String

      private def header: (String name, Entry entry, Integer size) -> String

      private def split_name: (String name) -> [String, String]?

      private def raw_header: (String name, Integer mode, Integer size, String typeflag, String link, String prefix) -> String

      private def write_padded: (String bytes) -> void
    end
  end
end
