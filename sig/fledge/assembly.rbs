module Fledge
  class Assembly
    interface _RuntimeTree
      def launcher: (String name) -> String

      def tools: () -> String?

      def move_into: (String folder) -> void
    end

    LAUNCHER: String
    WINDOWED_LAUNCHER: String
    TOOLS: String
    CONFIG: String

    @app: App
    @platform: Platform
    @runtime: String
    @out: String
    @app_files: Hash[String, String]
    @files: Array[Entry]
    @installers: Array[String]
    @signing: Signing::signer?
    @from: BuiltApp?
    @log: CLI::_Output?

    attr_reader installers: Array[String]

    def initialize: (app: App, platform: Platform, runtime: String, out: String, ?app_files: Hash[String, String], ?files: Array[Entry], ?signing: Signing::signer?, ?from: BuiltApp?, ?log: CLI::_Output?) -> void

    def base_name: () -> String

    def call: () -> String

    def launch_config: () -> String

    def self.launch_config: (App app, ?system_libraries: Array[String], ?built: String?) -> String

    private def self.single_config: (App app, Array[String] system_libraries) -> String

    private def self.config_value: (String path) -> String

    def self.app_entries: (App app, Hash[String, String] app_files, skip: Array[String]) -> Array[Entry]

    private def build: () -> String

    private def runtime_folder: (String work) -> _RuntimeTree

    private def place_launcher: (_RuntimeTree runtime, App::Program program, String? tools, ?into: String) -> String

    private def desktop: (Identity identity) -> void

    private def add: (String root, Entry entry) -> void

    private def finish: (MacBundle? bundle, _RuntimeTree runtime, String? tools) -> void

    private def mac_signing: () -> MacSigning?

    private def launcher_name: (App::Program program) -> String

    private def folder: () -> String

    private def archive: () -> String

    private def remove_output: () -> void

    private def copy_app: (String contents) -> void
  end
end
