module Fledge
  class HfsPlus
    class Item
      attr_reader id: Integer
      attr_reader parent: Integer
      attr_reader name: String
      attr_reader entry: Entry?
      attr_accessor extent: [Integer, Integer, Integer]?
      attr_accessor children: Integer
      attr_accessor folders: Integer

      def initialize: (Integer id, Integer parent, String name, Entry? entry) -> void
    end
  end
end
