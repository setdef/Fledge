module Fledge
  class Squashfs
    class Inodes
      @mtime: Integer
      @inodes: Metadata
      @directories: Metadata

      def initialize: (Integer mtime) -> void

      def inode_table: () -> String

      def directory_table: () -> String

      def write: (Node node, Node? parent) -> void

      private def write_file: (Node node, Integer permissions) -> void

      private def write_directory: (Node node, Node? parent, Integer permissions) -> void

      private def listing: (Node node) -> String

      private def block_of: (Node node) -> Integer

      private def run_bytes: (Array[[String, Node]] run) -> String

      private def header: (Integer type, Integer permissions, Node node) -> String
    end
  end
end
