module Fledge
  class AppImage
    RUNTIME: String
    ICON_SIZE: Integer

    @identity: Identity
    @to: String
    @image: Tempfile
    @squashfs: Squashfs

    def initialize: (identity: Identity, to: String, ?mtime: Integer) -> void

    def add: (Entry entry) -> void

    def finish: (Hash[String, Entry] kit) -> String

    def abort: () -> void

    private def appdir: () -> Array[Entry]
  end
end
