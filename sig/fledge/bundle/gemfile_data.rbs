module Fledge
  class Bundle
    module GemfileData
      def self.definition: (String gemfile) -> Hash[String, data]

      def self.gemspec: (String gemfile, String path) -> String?

      def self.specification: (String yaml, String path) -> Gem::Specification

      def self.dsl: (Hash[String, data] data) -> Bundler::Dsl

      private def self.describe: (Bundler::Dsl dsl) -> Hash[String, data]

      private def self.sources_of: (Bundler::SourceList list) -> Hash[String, Array[Bundler::Source]]

      private def self.ruby_data: (Bundler::RubyVersion ruby) -> Hash[String, data]

      private def self.source_data: (Bundler::Source source) -> Hash[String, data]

      private def self.dependency_data: (Bundler::Dependency dependency, Hash[String, Array[Bundler::Source]] known) -> Hash[String, data]

      private def self.rebuild_sources: (Bundler::SourceList list, Hash[String, data] data) -> Hash[String, Array[Bundler::Source]]

      private def self.remotes: (Bundler::Source::Rubygems source, Hash[String, data] data, ?global: bool) -> Bundler::Source::Rubygems

      private def self.dependency: (Hash[String, data] data, Hash[String, Array[Bundler::Source]] rebuilt) -> Bundler::Dependency

      private def self.option_table: (data source) -> Hash[String, Object?]

      private def self.encode: (Object? value) -> data

      private def self.decode: (data value) -> Object?

      private def self.decode_tagged: (Hash[String, data] value) -> Object?

      private def self.items: (data value) -> Array[data]

      private def self.table: (data value) -> Hash[String, data]

      private def self.string: (data value) -> String
    end
  end
end
