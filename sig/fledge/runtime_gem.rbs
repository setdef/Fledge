module Fledge
  class RuntimeGem < Data
    NAME: String
    FOLDER: String

    attr_reader target: String

    def self.new: (target: String) -> instance
                | (String target) -> instance

    def self.for: (target target) -> RuntimeGem

    def name: () -> String

    def platform: () -> String

    def desktop?: () -> bool
  end
end
