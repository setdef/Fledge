module Fledge
  class Icon < Data
    LINUX: Array[Integer]
    IOS: Integer
    ANDROID: Hash[String, Integer]
    MAKE: Hash[String, String]

    attr_reader base: String
    attr_reader name: String

    def self.new: (base: String, name: String) -> instance

    def file: (String extension) -> String

    def png: (Integer size, ?String system) -> String

    def linux: () -> Hash[Integer, String]

    def linux_missing: () -> Array[Integer]

    private def found: (String path, String shown, String system) -> String
  end
end
