module Fledge
  module TarGz
    BLOCK: Integer
    EXTENSION: String

    interface _Sink
      def write: (*String) -> Integer
    end

    interface _Source
      def read: (Integer) -> String?
    end

    def self.extension: () -> String

    def self.write: (String path, ?mtime: Integer) { (Writer) -> void } -> String

    def self.each_entry: (String path) { (Entry) -> void } -> void
  end
end
