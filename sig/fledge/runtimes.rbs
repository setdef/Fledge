module Fledge
  class Runtimes
    interface _Env
      def []: (String) -> String?

      def to_h: () -> Hash[String, String]
    end

    RELEASES: String
    EXTENSION: String
    PINS: String

    @env: _Env
    @release_url: String
    @log: CLI::_Output?
    @pins: String
    @waits: Array[Integer]

    def self.file_name: (target platform, ?version: String) -> String

    def initialize: (?env: _Env, ?release_url: String, ?log: CLI::_Output?, ?pins: String, ?waits: Array[Integer]) -> void

    def archive: (target platform) -> String

    def at_hand: (Platform platform) -> String?

    private def find: (String name) -> String

    def cache: () -> String

    private def from_directory: (String directory, String name) -> String

    private def pinned?: (String cached, String sha256) -> bool

    private def download: (String name, String destination, String sha256) -> String

    private def from_mirror: (String mirror, String name, String destination, String sha256) -> String

    private def pin: (String name) -> String
  end
end
