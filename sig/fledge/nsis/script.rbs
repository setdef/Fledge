module Fledge
  class Nsis
    class Script
      CLASSES: String
      CHANGE_NOTIFY: String

      @identity: Identity
      @folder: String
      @to: String
      @files: Array[String]
      @folders: Array[String]
      @size: Integer
      @signing: String?

      def initialize: (identity: Identity, folder: String, to: String, files: Array[String], folders: Array[String], size: Integer, ?signing: String?) -> void

      def text: (icon: String?, ?license: String?) -> String

      private def functions: () -> Array[String]

      private def install_section: () -> Array[String]

      private def uninstall_section: () -> Array[String]

      private def finalize: () -> Array[String]

      private def program: () -> String

      private def header: (String? icon) -> Array[String]

      private def aumid_macro: () -> Array[String]

      private def pages: (String? license) -> Array[String]

      private def registry: () -> Array[String]

      private def associations: () -> Array[String]

      private def dissociations: () -> Array[String]

      private def verb: () -> String

      private def open_command: () -> String

      private def prog_id: (Integer index) -> String

      private def extensions: (Config::FileAssociation association) -> Array[String]

      private def classes: (String path) -> String

      private def key: () -> String

      private def installed: (String path) -> String

      private def nsis: (String text) -> String

      private def quote: (String text) -> String
    end
  end
end
