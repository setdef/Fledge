module Fledge
  class Nsis
    UNINSTALL_KEY: String
    UNINSTALLER: String

    @identity: Identity
    @folder: String
    @to: String
    @makensis: String
    @files: Array[String]
    @folders: Array[String]
    @size: Integer

    def initialize: (identity: Identity, folder: String, to: String, makensis: String) -> void

    def add: (Entry entry) -> void

    def script: (icon: String?) -> String

    def finish: (Hash[String, Entry] kit) -> String

    def abort: () -> void

    def self.host_path: (String path) -> String

    private def compile: (String script_path, String nsis) -> void
  end
end
