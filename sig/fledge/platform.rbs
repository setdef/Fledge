module Fledge
  class Platform < Data
    NAMES: Array[String]
    MACOS_MINIMUM: String
    GLIBC_MINIMUM: String

    attr_reader name: String

    def self.new: (name: String) -> instance
                | (String name) -> instance

    def self.names: () -> Array[String]

    def self.find: (String) -> Platform

    def self.local: (?Gem::Platform) -> Platform

    private def self.target_name: (Gem::Platform) -> String

    def windows?: () -> bool

    def os: () -> String

    def macos_minimum: () -> String?

    def glibc_minimum: () -> String?

    def lockfile_names: () -> Array[String]

    def archive_format: () -> (singleton(TarGz) | singleton(Zip))

    def archive_extension: () -> String

    def executable: (String) -> String

    def to_s: () -> String
  end
end
