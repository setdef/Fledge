module Fledge
  class MobileProject
    class IOS < MobileProject
      FRAMEWORK: String
      SLICE: String
      ASSETS: String
      EXTENSIONS: String
      INSTALL: String

      def self.ruby_under: () -> String

      private def system: () -> String

      private def template_files: () -> Array[String]

      private def tokens: () -> Hash[String, String]

      private def extension_flags: () -> Array[String]

      private def place_extensions: (String project) -> void

      private def place_runtime: (String tree, String project) -> void

      private def ruby_root: (String project) -> String

      private def place_icons: (String project) -> void

      private def finish: (String project) -> void
    end
  end
end
