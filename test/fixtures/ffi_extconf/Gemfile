# echoer, a path gem whose extconf.rb builds a library for Ruby's ffi
# with no Init function, as sassc's builds libsass, and the ffi gem that
# opens it.
source "https://rubygems.org"

gem "echoer", path: "echoer"
gem "ffi", "1.17.4"
