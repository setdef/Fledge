module Fledge
  class Runtimes
    interface _Env
      def []: (String) -> String?

      def to_h: () -> Hash[String, String]
    end

    interface _Gems
      def find_all_by_name: (String name, *String requirements) -> Array[Gem::Specification]
    end

    RELEASES: String
    EXTENSION: String
    PINS: String

    @env: _Env
    @release_url: String
    @log: CLI::_Output?
    @pins: String
    @gems: _Gems

    def self.file_name: (target platform, ?version: String) -> String

    def self.dev_file_name: (Platform platform, ?version: String) -> String

    def initialize: (?env: _Env, ?release_url: String, ?log: CLI::_Output?, ?pins: String, ?gems: _Gems) -> void

    def archive: (target platform) -> String

    def dev_archive: (Platform platform) -> String

    private def find: (target platform, String name) -> String

    private def from_gem: (RuntimeGem gem, String name, String sha256) -> String?

    def cache: () -> String

    private def from_directory: (String directory, String name) -> String

    private def pinned?: (String cached, String sha256) -> bool

    private def download: (String name, String destination, String sha256) -> String

    private def pin: (String name) -> String
  end
end
