module Fledge
  class HfsPlus
    class Catalog
      @items: Array[Item]
      @names: Hash[Integer, String]
      @date: Integer

      def initialize: (Array[Item] items, Hash[Integer, String] names, Integer date) -> void

      def records: () -> Array[[String, String]]

      private def key: (Integer parent, String name) -> String

      private def thread: (Item item, String name) -> String

      private def record: (Item item) -> String

      private def file_record: (Item item, Entry entry) -> String

      private def folder_record: (Item item, Integer mode) -> String

      private def permissions: (Integer mode) -> String
    end
  end
end
