module Fledge
  class WindowsProgram
    class ResourceTable
      class Directory < Data
        attr_reader keys: Array[key]
        attr_reader children: Array[Directory | String]

        def self.new: (keys: Array[key], children: Array[Directory | String]) -> instance

        def self.of: [V] (Hash[key, V] hash) { (V) -> (Directory | String) } -> Directory
      end

      def self.sorted: (Array[key] keys) -> Array[key]

      @root: Directory

      def initialize: (Hash[resource, String] resources) -> void

      def bytes: (Integer address) -> String

      private def breadth_first: () -> Array[Directory]

      private def directory_offsets: (Array[Directory] directories) -> Array[Integer]

      private def targets: (Array[Directory] directories, Array[Integer] offsets, Integer entries_at) -> Array[Array[Integer]]

      private def data_offsets: (Array[String] leaves, Integer at) -> Array[Integer]

      private def name_strings: (Array[key] keys, Integer at) -> [String, Hash[String, Integer]]

      private def directory_bytes: (Array[key] keys, Hash[String, Integer] string_offsets, Array[Integer] pointers) -> String

      private def strings_in: (Array[key | Directory] values) -> Array[String]

      private def align: (Integer value, Integer alignment) -> Integer
    end
  end
end
