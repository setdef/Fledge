module Fledge
  class Nsis
    UNINSTALL_KEY: String
    UNINSTALLER: String
    MAKENSIS: String
    BOM: String
    CONFIG: String
    SIDEBAR_WIDTH: Integer
    SIDEBAR_HEIGHT: Integer
    REDISTRIBUTABLES: Hash[String, String]

    @identity: Identity
    @folder: String
    @to: String
    @signing: (WindowsSigning | SignCommand)?
    @license: String?
    @redistributable: String

    def initialize: (identity: Identity, folder: String, platform: Platform, to: String, ?signing: (WindowsSigning | SignCommand)?, ?license: String?, ?redistributable: String?) -> void

    def script: (icon: String?, ?license: String?, ?sidebar: String?) -> String

    def self.sidebar_bitmap: () -> String

    private def visual_c_runtime: () -> Array[String]

    def self.license_text: (String text) -> String

    def write: (String? tools) -> String

    def self.host_path: (String path) -> String

    private def compile: (String script_path, String nsis) -> void

    private def signing_failure: (String output) -> String
  end
end
