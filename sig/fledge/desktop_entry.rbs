module Fledge
  class DesktopEntry
    @identity: Identity

    def initialize: (Identity identity) -> void

    def entries: () -> Array[Entry]

    def text: () -> String

    def self.string: (String value) -> String

    def self.exec: (String program) -> String
  end
end
