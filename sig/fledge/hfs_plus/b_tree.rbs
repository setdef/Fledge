module Fledge
  class HfsPlus
    class BTree
      class Node < Data
        attr_reader number: Integer
        attr_reader first_key: String
        attr_reader bytes: String

        def self.new: (number: Integer, first_key: String, bytes: String) -> instance
      end

      @size: Integer
      @max_key: Integer
      @compare: Integer
      @attributes: Integer

      def initialize: (Integer size, max_key: Integer, compare: Integer, attributes: Integer) -> void

      def empty: () -> String

      def bytes: (Array[[String, String]] records) -> String

      private def index_level: (Array[Node] below, Integer height) -> Array[Node]

      private def pack_nodes: (Array[String] records, Array[String] keys, kind: Integer, height: Integer, first: Integer) -> Array[Node]

      private def groups: (Array[String] records) -> Array[Array[Integer]]

      private def node: (Integer kind, Integer height, Integer forward, Integer backward, Array[String] records) -> String

      private def header_node: (depth: Integer, root: Integer, leaf_records: Integer, first_leaf: Integer, last_leaf: Integer, total: Integer) -> String

      private def map: (Integer total) -> String
    end
  end
end
