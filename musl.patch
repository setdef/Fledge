-name=${folder%-*-*}
+# NAME-PLATFORM, where PLATFORM is arm64-darwin, x86_64-linux, or
+# aarch64-linux, with one hyphen, or with -musl after it, two.
+app_name() {
+  case "$1" in
+    *-linux-musl) echo "${1%-*-*-*}" ;;
+    *) echo "${1%-*-*}" ;;
+  esac
