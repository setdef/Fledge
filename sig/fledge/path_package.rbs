module Fledge
  class PathPackage
    @gem: PathGem
    @contents: Hash[String, String]?

    attr_reader spec: Gem::Specification
    attr_reader checkout: String
    attr_reader gemspec: String
    attr_reader folder: String

    def initialize: (PathGem gem) -> void

    def scope: () -> String

    def problems: (ruby_version: String) -> Array[String]

    def extensions?: () -> bool

    def contents: () -> Hash[String, String]

    def installed_path: (String gem_dir) -> String

    def entries: (String gem_dir) -> Array[Entry]

    def copy_to: (String destination) -> String

    def app_entries: (Array[Entry] built) -> Array[Entry]

    def app_files: (Array[Entry] built) -> Hash[String, String]

    private def evaluated_gemspecs: () -> Hash[String, String]

    private def git_files: () -> Array[String]
  end
end
