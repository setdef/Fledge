module Fledge
  class CLI
    class Build
      class Options < Data
        attr_reader out: String
        attr_reader path: String
        attr_reader phone: String?
        attr_reader sign: String?
        attr_reader from: String?

        def self.new: (out: String, path: String, phone: String?, sign: String?, from: String?) -> instance

        def self.parse: (Array[String] argv) -> Options

        private def self.value_of: (String option, Array[String] arguments, String name) -> String
      end
    end
  end
end
