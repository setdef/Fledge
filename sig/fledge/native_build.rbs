module Fledge
  class NativeBuild
    SCRUBBED: Regexp
    SCRIPT: String
    STUBS: String
    LOGS: Array[String]

    @work: String
    @runtime_ruby: RuntimeRuby

    attr_reader platform: Platform

    def initialize: (platform: Platform, runtimes: Runtimes, work: String, log: CLI::_Output, ?env: Runtimes::_Env) -> void

    def call: (Hash[locked_gem, package] packages, build_args: Hash[String, Array[String]]) -> Hash[locked_gem, package]

    def binstubs: (Hash[locked_gem, package] packages) -> Hash[locked_gem, Array[Entry]]

    private def stub_job: (locked_gem gem, package package) -> [locked_gem, Hash[String, String]]?

    private def program: (String bin, String name) -> Entry?

    private def install_order: (Hash[locked_gem, package] packages, Hash[locked_gem, package] wanted) -> Array[locked_gem]

    private def job: (locked_gem gem, package package, Array[String] args) -> [locked_gem, GemPackage | GitPackage | PathPackage, Hash[String, String | Array[String]], Array[String]]

    private def home: () -> String

    private def compiled_gem: (locked_gem gem, GemPackage | GitPackage | PathPackage package, Array[String] args, Hash[String, String | Array[String]] result) -> CompiledGem

    private def new_files: (GemPackage | GitPackage | PathPackage package, String gem_dir) -> Array[Entry]

    private def files_in: (String folder) -> Array[Entry]

    private def relative_to_home: (String path) -> String
  end
end
