source "https://rubygems.org"

# nokogiri's precompiled macOS and Windows builds compile GNU libiconv in
# statically, which Fledge refuses (ADR 005, section 7). Built from source
# on a Mac, it uses macOS's own iconv instead (ADR 006), and
# .bundle/config's build.nokogiri option, --disable-xml2-legacy, keeps
# libxml2 from linking the build machine's own liblzma.
gem "nokogiri", "1.19.4", force_ruby_platform: true
