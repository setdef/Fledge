module Fledge
  class GemFetcher
    PUBLIC_SERVERS: Array[String]

    @cache: String
    @project: String
    @gem_path: Array[String]
    @log: CLI::_Output?
    @waits: Array[Integer]
    attr_reader public_servers: Array[String]

    def initialize: (cache: String, project: String, ?gem_path: Array[String], ?log: CLI::_Output?, ?public_servers: Array[String], ?waits: Array[Integer]) -> void

    def fetch: (LockedGem gem) -> String

    private def forbids_only_what_it_lacks?: (LockedGem gem, Download::Refused error) -> bool

    private def missing: (LockedGem gem, Integer status) -> String

    private def refused: (LockedGem gem, Download::Refused error) -> String

    private def candidates: (LockedGem gem, String cached) -> Array[String]
  end
end
