module Fledge
  class App < Data
    NEVER_SHIPPED: Array[String]

    attr_reader root: String

    def self.new: (root: String) -> instance

    def self.at: (String path) -> App

    def name: () -> String

    def entries: (?skip: Array[String]) -> Array[Entry]
  end
end
