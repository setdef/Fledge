#!/usr/bin/env ruby
# frozen_string_literal: true

# SPDX-FileCopyrightText: 2026 setdef <kerrick@setdef.com>
# SPDX-License-Identifier: MIT

# The fast check before a push, as one command from a checkout on every
# system, on a computer that has only git and mise:
#
#   mise x -- ruby bin/check [BASE]
#
# It is a Ruby script, as a Rails app's bin/ scripts are, so that it
# starts the same from PowerShell, cmd, or a Unix shell, and as the one
# command of an automated run. mise x puts first on PATH the Ruby
# mise.toml pins, installing first whatever tool is missing
# (https://mise.jdx.dev/cli/exec.html), so the command finds that Ruby
# with no shell mise has activated, and before anything is installed.
# The script sets the checkout up (tasks/setup.rb, the same file on every
# system), then runs rake check (tasks/check.rake) with the Ruby and
# tools mise.toml pins, of the commits since BASE, which defaults to the
# upstream, or else origin/trunk.
#
#   mise x -- ruby bin/check --runtime[=PLATFORM] [BASE]
#
# for a commit that changes a runtime, or the Ruby a parity check
# compares one with, then proves the change once the fast check passes:
# rake runtime:prove (tasks/runtime_proof.rb) builds this computer's
# runtime, or PLATFORM's (android), and runs CI's checks of apps built
# from it.
Dir.chdir(File.expand_path("..", __dir__))

proof, arguments = ARGV.partition { |argument| argument.start_with?("--runtime") }
tasks = [arguments.empty? ? "check" : "check[#{arguments.first}]"]
unless proof.empty?
  platform = proof.first.split("=", 2)[1]
  tasks << (platform ? "runtime:prove[#{platform}]" : "runtime:prove")
end

require_relative "../tasks/setup"
Setup.new.run.zero? or abort "❌ bin/check: tasks/setup.rb failed"

exec "mise", "x", "--", "bundle", "exec", "rake", *tasks
