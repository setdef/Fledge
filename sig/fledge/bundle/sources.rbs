module Fledge
  class Bundle
    class Sources
      @root: String
      @lockfile_name: String
      @checksums: Hash[String, String]

      def initialize: (root: String, lockfile_name: String, checksums: Hash[String, String]) -> void

      def gem_for: (Bundler::LazySpecification spec, target platform) -> locked_gem?

      private def rubygem: (Bundler::LazySpecification spec, Bundler::Source::Rubygems source, target platform) -> LockedGem

      def bundler: (String version) -> LockedGem

      private def git_gem: (Bundler::LazySpecification spec, Bundler::Source::Git source) -> GitGem

      private def own_gem: (Bundler::LazySpecification spec, Bundler::Source::Path source) -> PathGem?

      private def copy_of: (Bundler::LazySpecification spec, String original) -> String

      private def outside_app_path: (Bundler::LazySpecification spec, String original, Bundler::Source::Path source) -> String

      private def relative_to_root: (String folder) -> String

      private def path_gemspec: (String folder, String name, Bundler::Source::Path source) -> Gem::Specification?

      def own_folder: (Bundler::LazySpecification spec) -> String?

      private def inside_project?: (String folder) -> bool
    end
  end
end
