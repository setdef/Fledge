module Fledge
  class Icon < Data
    LINUX: Array[Integer]
    MAKE: Hash[String, String]

    attr_reader base: String
    attr_reader name: String

    def self.new: (base: String, name: String) -> instance

    def file: (String extension) -> String

    def png: (Integer size) -> String

    private def found: (String path, String shown, String extension) -> String
  end
end
