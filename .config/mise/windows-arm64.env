#
# What `ridk enable` sets for RubyInstaller's ARM64 Ruby, besides PATH
# and RI_DEVKIT (mise.toml), as RubyInstaller's
# lib/ruby_installer/build/msys2_installation.rb, msys_apps_envvars, sets
# them at rubyinstaller2 92a692c, the commit that built the head build
# mise.toml pins; MAKE as ruby/setup-ruby sets it before ridk enable.
# mise.toml loads this file on Windows on ARM64 only.
MAKE=make
MSYSTEM=CLANGARM64
MSYSTEM_PREFIX=/clangarm64
MSYSTEM_CARCH=aarch64
MSYSTEM_CHOST=aarch64-w64-mingw32
MINGW_CHOST=aarch64-w64-mingw32
MINGW_PREFIX=/clangarm64
MINGW_PACKAGE_PREFIX=mingw-w64-clang-aarch64
PKG_CONFIG_PATH=/clangarm64/lib/pkgconfig:/clangarm64/share/pkgconfig
ACLOCAL_PATH=/clangarm64/share/aclocal:/usr/share/aclocal
MANPATH=/clangarm64/share/man
