module Fledge
  class Png < Data
    SIGNATURE: String
    CHANNELS: Hash[Integer, Integer]
    DEPTHS: Hash[Integer, Array[Integer]]
    ADAM7: Array[[Integer, Integer, Integer, Integer]]
    MAX_SIDE: Integer

    attr_reader width: Integer
    attr_reader height: Integer
    attr_reader pixels: String

    def self.new: (width: Integer, height: Integer, pixels: String) -> instance

    def self.read: (String bytes) -> Png

    private def self.chunks_of: (String bytes) -> Array[[String, String]]

    private def self.check_header: (Integer width, Integer height, Integer depth, Integer color, Array[Integer] methods) -> void

    private def self.inflate: (String data) -> String

    def encode: () -> String

    private def chunk: (String type, String data) -> String
  end
end
