module Fledge
  class Binary < Data
    ELF_MAGIC: String
    AR_MAGIC: String
    MACHO_MAGICS: Array[String]
    FAT_MAGIC: String
    DT_NEEDED: Integer
    DT_RPATH: Integer
    DT_RUNPATH: Integer
    SHT_DYNAMIC: Integer
    SHT_GNU_VERNEED: Integer
    LC_DYLIBS: Array[Integer]
    LC_RPATH: Integer
    LC_BUILD_VERSION: Integer
    LC_VERSION_MIN_MACOSX: Integer

    attr_reader format: Symbol
    attr_reader needed: Array[String]
    attr_reader rpaths: Array[String]
    attr_reader assemblies: Array[String]

    def self.new: (format: Symbol, needed: Array[String], rpaths: Array[String], assemblies: Array[String]) -> instance

    def self.read: (String path) -> Binary?

    def self.parse: (String bytes) -> Binary?

    def self.macos_minimum: (String bytes) -> String?

    private def self.version_text: (Integer packed) -> String

    def self.glibc_minimum: (String bytes) -> String?

    private def self.needed_versions: (String bytes, Integer at, Integer strings, String half, String long) -> Array[String]

    private def self.elf: (String bytes) -> Binary

    private def self.elf_section: (String bytes, Integer at, bool wide, String word, String long) -> Hash[Symbol, Integer]

    private def self.macho: (String bytes, Integer base) -> Binary

    private def self.fat: (String bytes) -> Binary

    private def self.pe?: (String bytes) -> bool

    private def self.pe: (String bytes) -> Binary

    private def self.pe_names: (String bytes, ^(Integer) -> Integer? at, Integer rva, Integer size, Integer name_at) -> Array[String]

    private def self.number: (String bytes, Integer offset, Integer size, String format) -> Integer

    private def self.c_string: (String bytes, Integer offset) -> String
  end
end
