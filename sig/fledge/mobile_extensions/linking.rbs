module Fledge
  class MobileExtensions
    module Linking
      CXX_RUNTIMES: Array[String]

      def self.link_flags: (String text, dir: String) -> Array[String]

      def self.cxx_runtime?: (String text) -> bool

      def self.local_libs: (Hash[String, String?] env, String dir) -> String

      LOCAL_LIBS_MARK: String

      LOCAL_LIBS_GOAL: String

      def self.target_build: (Target target, Array[Report] reports, libraries: Array[Library]) -> TargetBuild

      def self.shared_libraries: (Array[String] flags) -> Array[String]

      def self.carry_shared_libraries: (Array[String] flags, into: String) -> Array[String]
    end
  end
end
