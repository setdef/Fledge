module Fledge
  class Dmg
    APPLICATIONS: Entry
    PARTITION: String

    @to: String
    @volume_file: Tempfile
    @volume: HfsPlus

    def initialize: (name: String, to: String, ?mtime: Integer) -> void

    def add: (Entry entry) -> void

    def finish: (?Hash[String, Entry] _kit) -> String

    def abort: () -> void
  end
end
