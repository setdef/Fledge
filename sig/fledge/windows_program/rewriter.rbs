module Fledge
  class WindowsProgram
    class Rewriter
      @bytes: String
      @headers: Headers

      def initialize: (String bytes, Headers headers) -> void

      def rewrite: (Headers::Section section, String table, Array[Headers::Section] later) -> String

      private def append_moved: (String out, Array[Headers::Section] later, Integer address) -> Integer

      private def finish_headers: (String out, Integer image_size, Integer growth) -> void

      private def move_directories: (String out, Headers::Section moved, Integer address) -> void

      private def write_section: (String out, Headers::Section section, size: Integer, address: Integer, raw_size: Integer, raw: Integer) -> void

      private def write_directory: (String out, Integer index, Integer rva, Integer size) -> void

      private def put32: (String out, Integer at, Integer value) -> void

      private def align: (Integer value, Integer alignment) -> Integer
    end
  end
end
