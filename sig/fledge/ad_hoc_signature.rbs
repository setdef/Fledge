module Fledge
  class AdHocSignature
    EMBEDDED_SIGNATURE: Integer
    CODE_DIRECTORY: Integer
    REQUIREMENTS: Integer
    BLOB_WRAPPER: Integer
    REQUIREMENTS_SLOT: Integer
    SIGNATURE_SLOT: Integer
    VERSION: Integer
    ADHOC: Integer
    SHA256: Integer
    PAGE_BITS: Integer
    MAIN_BINARY: Integer
    HEADER_SIZE: Integer
    MAGIC_64: Integer
    LC_SEGMENT_64: Integer
    LC_CODE_SIGNATURE: Integer
    SEGMENT_ALIGNMENT: Integer

    @identifier: String
    @special: Array[String]

    def initialize: (identifier: String, info_plist: String, code_resources: String) -> void

    def sign: (String program) -> String

    private def load_commands: (String program) -> Hash[Integer, Array[Integer]]

    private def segment: (String program, Hash[Integer, Array[Integer]] commands, String name) -> Integer

    private def signature_size: (Integer limit) -> Integer

    private def superblob: (String code, Integer text_offset, Integer text_size) -> String

    private def code_directory: (String code, Integer text_offset, Integer text_size) -> String

    private def requirements: () -> String

    private def u32: (String bytes, Integer at) -> Integer

    private def u64: (String bytes, Integer at) -> Integer

    private def align: (Integer value, Integer alignment) -> Integer
  end
end
