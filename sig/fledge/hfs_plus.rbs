module Fledge
  class HfsPlus
    BLOCK: Integer
    CATALOG_NODE: Integer
    EXTENTS_NODE: Integer
    EPOCH: Integer
    ROOT_PARENT: Integer
    ROOT: Integer
    FIRST_ID: Integer
    FOLDER_RECORD: Integer
    FILE_RECORD: Integer
    FOLDER_THREAD: Integer
    FILE_THREAD: Integer
    THREAD_EXISTS: Integer
    HAS_FOLDER_COUNT: Integer
    UNMOUNTED: Integer
    UNKNOWN_OWNER: Integer
    UNDECOMPOSED: Array[Range[Integer]]
    NAME_MAX: Integer

    @io: IO
    @name: String
    @date: Integer
    @next_block: Integer
    @next_id: Integer
    @items: Hash[String, Item]
    @hfs_name: Hash[Integer, String]

    def initialize: (IO io, name: String, ?mtime: Integer) -> void

    def add: (Entry entry) -> void

    def finish: () -> Integer

    private def folder: (String path) -> Item

    private def write_data: (String bytes) -> [Integer, Integer, Integer]

    private def write_at: (Integer block, String bytes) -> void

    def self.fork_data: (Integer start, Integer blocks, Integer size) -> String

    private def volume_header: (Integer total, Hash[Symbol, String] forks) -> String

    private def volume_id: () -> String

    private def extents_tree: () -> String

    private def catalog_tree: () -> String
  end
end
