// The command-line reference for fledge, as a Usage spec (https://usage.jdx.dev).
// `usage generate markdown`, `usage generate manpage`, and
// `usage generate completion` read it; `usage lint` checks it.

min_usage_version "7.0"

name "Fledge"
bin "fledge"
version "0.17.0"
author "setdef"
license "MIT"
repository "https://github.com/setdef/Fledge"

about "Ship a Ruby app to people who don't have Ruby"
long_about """
    fledge builds the Ruby program you run, its project, and the gems its
    Gemfile.lock locks into an app for the computer you run it on. The app
    carries a Ruby, and starts the program as `bundle exec ruby` would.
    The person who runs it needs no Ruby, and any Ruby they have changes
    nothing in the app.

    Each platform's app is built on a computer of that platform. A phone's app
    is an Xcode or Gradle project that fledge writes, which you build, sign,
    and ship with Xcode or Gradle.

    fledge reads the project's fledge.kdl, when it has one, for how the app
    presents itself: its name, icon, identifier, installers, and the files it
    opens.
    """
after_long_help """
    Guides and the fledge.kdl reference:
      https://github.com/setdef/Fledge/tree/trunk/docs

    Questions and bug reports:
      https://forum.setdef.com/c/fledge
    """

arg_required_else_help #true

example "fledge build" header="Build the app in this folder" help="Writes the app's archive, and a windowed app's installers, into dist."
example "fledge build bin/greet" header="Build one program of a project"
example "fledge ios project" header="Write the iOS app's Xcode project"
example "fledge android run test/phone.rb" header="Run a program on an Android emulator" help="Exits with the program's status, so a test suite can gate a release."

exit_code 0 "Fledge finished what it was asked to do."
exit_code 1 "Fledge could not finish. Standard error says why, and what to change."
exit_code 2 "The command line is wrong. Standard error says what, and shows the usage."

config {
    prop "runtime.dir" type="path" help="A folder of Fledge runtimes to build with in place of the release's" {
        env "FLEDGE_RUNTIME_DIR"
        long_help """
            A folder of runtime archives, named as in Fledge's release, such as
            fledge-runtime-0.17.0-x86_64-linux.tar.gz. When it is set, fledge looks for a
            runtime there and nowhere else: it neither downloads nor reads its cache.
            A runtime there must have the SHA-256 this Fledge pins for it, unless
            runtime.unchecked is set; one this Fledge pins nothing for is used, and fledge
            says on standard error that it went unchecked.
            """
    }
    prop "runtime.unchecked" type="bool" default=#false help="Use a runtime from runtime.dir whose SHA-256 differs from the pin" {
        env "FLEDGE_RUNTIME_DIR_UNCHECKED"
        long_help """
            For a runtime you built yourself from Fledge's source. Any value but an empty one,
            0, false, f, no, or n turns it on, and fledge says on standard error each time it
            uses a runtime unchecked.
            """
    }
    prop "runtime.mirror" type="url" help="A server that holds copies of Fledge's release files" {
        env "FLEDGE_RUNTIME_MIRROR"
        long_help """
            fledge downloads a runtime from MIRROR/v0.17.0/NAME in place of Fledge's release,
            and checks it against the SHA-256 this Fledge pins. A mirror that lacks the file,
            or serves other bytes, fails the build: fledge never falls back to the release.
            runtime.dir wins over a mirror.
            """
    }
    prop "cache.home" type="path" default_note="~/.cache" help="The folder of every program's cache, which holds fledge's in its fledge folder" {
        env "XDG_CACHE_HOME"
        long_help """
            XDG_CACHE_HOME is the path of the folder that holds the caches of all your
            programs, not fledge's alone. fledge keeps what it downloads in the fledge
            folder there: runtimes in fledge/runtimes, gems in fledge/gems, and clones of
            git gems in fledge/git. When XDG_CACHE_HOME is unset or empty, fledge uses .cache in your
            home folder, on macOS and Windows as well as Linux.

            fledge uses a runtime or a gem from its cache only when the file's SHA-256 is
            the one this Fledge pins or the lockfile locks, and downloads it again when it
            is not. A clone that lacks the commit the lockfile locks is fetched again.
            """
    }
    prop "sign.command" type="string" help="The Windows signing command to use when the build gives none" {
        env "FLEDGE_SIGN_COMMAND"
        long_help """
            On Windows, a build that has neither --sign nor --sign-command signs with this
            command, as --sign-command would. fledge ignores it on other systems.
            """
    }
    prop "appimage.timestamp" type="int" help="The time, in seconds since 1970, that an AppImage's file system records" {
        env "SOURCE_DATE_EPOCH"
        long_help """
            When SOURCE_DATE_EPOCH is set, fledge leaves the AppImage's times to mksquashfs,
            which reads the variable itself. When it is unset, fledge gives the file system
            a creation time of 0, and the files keep the times they have in the app's folder.
            """
    }
    prop "android.sdk" type="path" help="The Android SDK, whose adb runs a phone's app" {
        env "ANDROID_HOME" "ANDROID_SDK_ROOT"
    }
    prop "android.ndk" type="path" help="The Android NDK, which compiles a gem's extension for Android" {
        env "ANDROID_NDK_ROOT" "ANDROID_NDK_HOME"
        long_help """
            Without it, fledge looks for the newest NDK in the ndk folder of the SDK that
            ANDROID_HOME or ANDROID_SDK_ROOT points at, then in ~/Library/Android/sdk and
            ~/Android/Sdk.
            """
    }
}

cmd "build" effect="write" help="Build the app for this computer" {
    long_help """
        Builds the app for the platform of the computer you run it on: its folder, that
        folder packed as an archive (a .zip on Windows, a .tar.gz elsewhere), and, for a
        windowed app, its installers. It prints the path of each archive and installer,
        one per line, and writes each one's SHA-256 beside it, in a file named for it with
        .sha256 added.

        Run fledge with the Ruby the runtime has, Ruby 4.1. A project with a Gemfile
        needs its Gemfile.lock, locked for this computer's platform or for ruby, with a
        checksum for every gem.
        """

    arg "[path]" default="." help="The program to ship, or its project's folder" {
        long_help """
            A file is the program the app runs. When the project's fledge.kdl lists
            programs, the file must be one of them, and the app holds that program alone.

            For a folder, fledge takes the first of these that the project has: every
            program its fledge.kdl lists; the executable its gemspec lists, when the
            gemspec lists exactly one and the file exists; the folder's main.rb. A folder
            with none of them fails the build.

            The project is the nearest folder at or above PATH that holds a Gemfile, a
            gems.rb, a fledge.kdl, or a gemspec, without passing a folder that holds .git,
            or else PATH itself when it is a folder, or the folder that holds it when it is
            a file. The app carries the whole project but .git, .bundle, vendor/bundle,
            vendor/cache, and any folder a CACHEDIR.TAG marks, which is how earlier builds
            stay out.
            """
        warning "fledge refuses a project at your home folder: it would ship everything in it."
    }

    flag "-o --out <dir>" default="dist" help="Where to write the app" {
        long_help """
            fledge makes the folder, and marks it with a CACHEDIR.TAG so that backups
            and later builds skip it. It may not be the project's folder.
            """
        warning "A build replaces the app, archive, and installers an earlier build of the same name wrote in this folder."
    }

    flag "--sign <identity>" available_if="macos windows" help="Sign the app's code" {
        long_help #"""
            On macOS, IDENTITY is a codesign identity in your keychain, such as
            "Developer ID Application: Example, Inc. (TEAMID)", or - for an ad hoc
            signature. fledge signs every file of code with the hardened runtime, then the
            bundle, then the disk image.

            On Windows, IDENTITY is the SHA-1 thumbprint of a code-signing certificate in
            your certificate store: 40 hexadecimal digits, as
            (Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert).Thumbprint prints them.
            fledge signs with signtool from the Windows SDK, with SHA-256 and a timestamp.

            A Linux app carries no signature for its system to check, so fledge refuses
            --sign there.
            """#
    }

    flag "--sign-command <command>" available_if="windows" conflicts="--sign" help="Sign each Windows file of code with a command you give" {
        long_help """
            fledge runs COMMAND once for each .exe, .dll, and .so in the app, then for the setup
            program's uninstaller, the setup program, and the MSIX package. It puts the
            file's path, in double quotes, in place of %1, or after the command when it
            has no %1. Use it for a signing service or a hardware token that signtool alone
            cannot reach.
            """
        note "FLEDGE_SIGN_COMMAND supplies this flag when neither --sign nor --sign-command is given."
    }

    flag "--notarize <profile>" available_if="macos" requires="--sign" help="Have Apple notarize the app, and staple its ticket" {
        long_help """
            PROFILE is the name of the credentials you stored once with
            xcrun notarytool store-credentials PROFILE. fledge submits the disk image, or the
            bundle when there is none, waits for Apple's answer, staples the ticket to each,
            and only then packs the archive. --sign must name a Developer ID Application
            identity: Apple notarizes no ad hoc signature.
            """
        note "Notarizing takes minutes, and needs the network."
    }

    flag "--from <app>" help="Build from an app fledge built, with its runtime and gems" {
        long_help """
            APP is the folder of an app this Fledge built for this platform, such as
            dist/Greet-x86_64-linux, or its .app bundle. fledge keeps APP's runtime, gems,
            Gemfile, and lockfile, and takes the rest of the project from PATH. It reads
            no lockfile, compiles no gem, and downloads no runtime, so an app that carries
            Fledge as a gem can build a new app from itself on a computer with no Ruby.

            The project at PATH may hold no Gemfile, gemspec, or file that APP takes, and its
            fledge.kdl may not name programs or change the runtime or gems. On Windows, APP
            must have been built with build-tools in its fledge.kdl, or this computer must
            have this Fledge's Windows runtime in its cache.
            """
    }

    exit_code 0 "The app is built, and each file written is printed."

    example "fledge build" header="Build the project in this folder"
    example "fledge build --out build bin/greet" header="Build one program into another folder"
    example "fledge build --sign \"Developer ID Application: Example, Inc. (ABCDE12345)\" --notarize notary" header="Sign and notarize a Mac app"
    example "fledge build --sign-command \"signtool sign /fd sha256 /a %1\"" header="Sign a Windows app with a command you give"
}

cmd "ios" subcommand_required=#true help="Write or run the app for iPhone and iPad" {
    long_help """
        An iOS app's project is written on a Mac with Apple silicon, and built with
        Xcode. fledge writes it with XcodeGen, which must be on PATH.
        """

    cmd "project" effect="write" help="Write the app's Xcode project" {
        long_help """
            Writes an Xcode project that holds the iOS runtime, the app's project, its gems,
            and their extensions compiled for iPhone and the Simulator, and prints its folder.
            Open it in Xcode to run, sign, and archive the app.

            The app needs an identifier in fledge.kdl, its bundle identifier, and runs every
            program's Ruby on the main thread. The gems are the lockfile's builds for the
            ruby platform, so the lockfile must lock ruby.
            """
        arg "[path]" default="." help="The program to ship, or its project's folder"
        flag "-o --out <dir>" default="dist" help="Where to write the project" {
            warning "fledge replaces a project of the same name in this folder, with any change you made to it."
        }
        example "fledge ios project" header="Write the project for the app in this folder"
    }

    cmd "run" effect="write" help="Run a program in the iOS Simulator, and exit with its status" {
        long_help """
            Writes the app's project for PATH, builds it with xcodebuild for the Simulator,
            installs it on the booted Simulator, launches it, and prints what the program
            prints as it prints it. fledge exits with the program's exit status, or 1 when
            fledge itself fails or the status is outside 0 to 255.

            Boot one Simulator first, such as with open -a Simulator; with more than one
            booted, name it with --device.
            """
        arg "[path]" default="." help="The program to run in the app, such as test/phone.rb"
        flag "-o --out <dir>" default="dist/test" help="Where to write the project"
        flag "-d --device <udid>" help="The booted Simulator to run on, by its UDID"
        exit_code 0 "The program exited with status 0."
        exit_code 1 "Fledge could not build or run the app, or the program exited with status 1."
        example "fledge ios run test/phone.rb" header="Run a test program in the Simulator"
    }
}

cmd "android" subcommand_required=#true help="Write or run the app for Android" {
    long_help """
        An Android app's project is written on a Mac with Apple silicon, on x86-64
        Linux, or on x64 Windows, and built with Gradle. A gem with an extension compiles
        for Android only on the Mac or Linux, with the Android NDK.
        """

    cmd "project" effect="write" help="Write the app's Gradle project" {
        long_help """
            Writes a Gradle project that holds the Android runtime, the app's project, its
            gems, and their extensions compiled for arm64-v8a and x86_64, and prints its
            folder. Build, sign, and bundle the app with its Gradle wrapper, or open it in
            Android Studio.

            The app needs an identifier in fledge.kdl, its applicationId, and runs every
            program's Ruby on the main thread. The gems are the lockfile's builds for the
            ruby platform, so the lockfile must lock ruby.
            """
        arg "[path]" default="." help="The program to ship, or its project's folder"
        flag "-o --out <dir>" default="dist" help="Where to write the project" {
            warning "fledge replaces a project of the same name in this folder, with any change you made to it."
        }
        example "fledge android project" header="Write the project for the app in this folder"
    }

    cmd "run" effect="write" help="Run a program on an Android device or emulator, and exit with its status" {
        long_help """
            Writes the app's project for PATH, builds its debug APK with Gradle, installs it
            with adb, launches it, and prints what the program prints as it prints it.
            fledge exits with the program's exit status, or 1 when fledge itself fails or
            the status is outside 0 to 255.

            fledge runs the adb in the SDK at ANDROID_HOME or ANDROID_SDK_ROOT, or
            else the adb on PATH, on the one device adb sees, or the one you give --device.
            """
        arg "[path]" default="." help="The program to run in the app, such as test/phone.rb"
        flag "-o --out <dir>" default="dist/test" help="Where to write the project"
        flag "-d --device <serial>" help="The device or emulator to run on, by the serial adb devices prints"
        exit_code 0 "The program exited with status 0."
        exit_code 1 "Fledge could not build or run the app, or the program exited with status 1."
        example "fledge android run test/phone.rb" header="Run a test program on the one device adb sees"
        example "fledge android run --device emulator-5554 test/phone.rb" header="Run it on one emulator of several"
    }
}
