module Fledge
  module Installers
    OS: Hash[String, String]
    SUFFIX: Hash[String, String]

    def self.formats: (App app, Platform platform) -> Array[String]

    def self.file_name: (String format, String base) -> String

    def self.write_all: (App app, Platform platform, folder: String, tools: String?, ?signing: Signing::signer?) -> Array[String]

    def self.write: (String format, app: App, folder: String, platform: Platform, tools: String?, ?signing: Signing::signer?) -> String

    private def self.windows_signer: (Signing::signer? signing) -> (WindowsSigning | SignCommand)?

    private def self.deb: (App app, folder: String, platform: Platform, to: String) -> String

    def self.license: (App app) -> String?

    private def self.project_file: (App app, String name, String key) -> String
  end
end
