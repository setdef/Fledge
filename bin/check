#!/usr/bin/env ruby
# frozen_string_literal: true

# SPDX-FileCopyrightText: 2026 setdef <kerrick@setdef.com>
# SPDX-License-Identifier: MIT

# The fast check before a push, as one command from a checkout on every
# system: ruby bin/check [BASE]. It is a Ruby script, as a Rails app's
# bin/ scripts are, so that it starts the same from PowerShell, cmd, or
# a Unix shell (where bin/check also runs it), and as the one command of
# an automated run. It sets the checkout up (bin/setup, or bin/setup.ps1
# on Windows), then runs rake check (tasks/check.rake) with the Ruby and
# tools mise.toml pins, of the commits since BASE, which defaults to the
# upstream, or else origin/trunk.
Dir.chdir(File.expand_path("..", __dir__))

setup = if Gem.win_platform?
  %w[powershell -NoProfile -ExecutionPolicy Bypass -File bin\\setup.ps1]
else
  %w[bin/setup]
end
system(*setup) or abort "❌ bin/check: #{setup.join(' ')} failed"

task = ARGV.empty? ? "check" : "check[#{ARGV.first}]"
exec "mise", "x", "--", "bundle", "exec", "rake", task
