module Fledge
  class Assembly
    class RuntimeArchive
      @path: String
      @platform: Platform
      @app_name: String

      def initialize: (String path, platform: Platform, app_name: String) -> void

      def copy: (String launcher_name, Hash[String, Entry] kit) { (Entry) -> void } -> Entry

      private def each_entry: () { (Entry, String) -> void } -> void

      private def app_path: (String path) -> String
    end
  end
end
