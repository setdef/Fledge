# Markdown to HTML's console program: prints the HTML of the Markdown
# files it is given, one after another, or of what it reads when it is
# given none or -, as Markdown.pl and kramdown's own command do; with
# --page, as a whole page, the one the droplet writes.
#
#   bin/md2html [--page] [FILE...] > out.html

require_relative "../lib/markdown_to_html"

USAGE = "usage: md2html [--page] [FILE...]"

page = ARGV.delete("--page")
if ARGV.delete("--help")
  puts USAGE
  exit
end
unknown = ARGV.find { |argument| argument.start_with?("-") && argument != "-" }
if unknown
  warn "md2html: unknown option #{unknown}\n#{USAGE}"
  exit 64
end

# A page's title comes from its first file, or is stdin.
source = (ARGV.fetch(0, "-") == "-") ? "stdin" : ARGV.fetch(0)
begin
  markdown = ARGF.read.force_encoding(Encoding::UTF_8).delete_prefix("\u{FEFF}")
rescue SystemCallError => e
  warn "md2html: #{MarkdownToHtml.reason(e)}"
  exit 66
end
html = MarkdownToHtml.to_html(markdown)
html = MarkdownToHtml::Page.html(html, title: File.basename(source)) if page
$stdout.write(html)
