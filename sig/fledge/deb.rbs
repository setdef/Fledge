module Fledge
  module Deb
    ARCHITECTURES: Hash[String, String]
    INSTALL: String
    SHLIBDEPS: String

    def self.write: (identity: Identity, folder: String, platform: Platform, to: String, ?system_libraries: Array[String], ?system_typelibs: Array[String], ?license: String?, ?changelog: String?) -> String

    def self.typelib_packages: (Array[String] typelibs) -> Array[String]

    private def self.documents: (String root, String package, license: String?, changelog: String?) -> void

    def self.package_name: (Identity identity) -> String

    def self.version: (String version) -> String

    private def self.lay_out: (String root, String folder, Identity identity, String package) -> void

    def self.extended: (String? text) -> String

    private def self.control_file: (Identity identity, String package, String architecture, Integer size, Array[String] depends) -> String

    private def self.compiled: (String root, String cpu) -> Hash[String, Binary]

    private def self.glibc: (Hash[String, Binary] binaries) -> String

    private def self.dependencies: (String work, Hash[String, Binary] binaries, Array[String] libraries) -> Array[String]

    private def self.elf?: (String path) -> bool

    private def self.line: (String text) -> String

    private def self.installed_size: (String root) -> Integer
  end
end
