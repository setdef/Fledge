module Fledge
  class Config < Data
    FILE: String
    KEYS: Array[String]
    KNOWN: String
    KINDS: Array[String]
    INSTALLERS: Array[String]

    DEFAULT_INSTALLERS: Array[String]
    IDENTIFIER: Regexp
    IDENTIFIER_MAX: Integer
    HOMEPAGE: Regexp
    PER_PROGRAM: Array[String]
    PHONES: Array[String]

    attr_reader name: String?
    attr_reader kind: String?
    attr_reader identifier: String?
    attr_reader version: String?
    attr_reader icon: String?
    attr_reader publisher: String?
    attr_reader copyright: String?
    attr_reader description: String?
    attr_reader long_description: String?
    attr_reader homepage: String?
    attr_reader installers: Array[String]?
    attr_reader programs: Array[Config::Program]?
    attr_reader ios: Config::Phone?
    attr_reader android: Config::Phone?
    attr_reader linux: Config::Linux?

    def self.new: (name: String?, kind: String?, identifier: String?, version: String?, icon: String?, publisher: String?, copyright: String?, description: String?, long_description: String?, homepage: String?, installers: Array[String]?, programs: Array[Config::Program]?, ios: Config::Phone?, android: Config::Phone?, linux: Config::Linux?) -> instance

    def self.none: () -> Config

    def self.load: (String root) -> Config

    private def self.read: (String path) -> Object

    private def self.from: (Object data, String path) -> Config

    def for_program: (Config::Program program) -> Config

    def system_libraries: (String os) -> Array[String]

    private def self.programs: (Hash[Object, Object] data, String path) -> Array[Config::Program]?

    private def self.unique: (Array[Config::Program] programs, String path, String what) { (Config::Program) -> String } -> void

    private def self.windowed?: (Hash[Object, Object] data) -> bool

    def self.text: (Hash[Object, Object] data, String key, String path, String example) -> String?

    def self.inside?: (String path) -> bool

    def self.kind: (Hash[Object, Object] data, String path) -> String?

    def self.identifier: (Hash[Object, Object] data, String path) -> String?

    private def self.version: (Hash[Object, Object] data, String path) -> String?

    private def self.description: (Hash[Object, Object] data, String path) -> String?

    private def self.homepage: (Hash[Object, Object] data, String path) -> String?

    def self.icon: (Hash[Object, Object] data, String path) -> String?

    private def self.installers: (Hash[Object, Object] data, String path) -> Array[String]?
  end
end
