module Fledge
  class Assembly
    class Placement
      @folder: String
      @base_name: String
      @writer: TarGz::Writer | Zip::Writer
      @bundle: MacBundle?
      @installers: Array[Installers::writer]
      @runtime: String
      @placed: Hash[String, bool]

      def initialize: (folder: String, base_name: String, writer: TarGz::Writer | Zip::Writer, bundle: MacBundle?, installers: Array[Installers::writer], runtime: String) -> void

      def add: (Entry entry) -> void

      def put: (Entry entry) -> void

      private def place: (Entry entry) -> void
    end
  end
end
