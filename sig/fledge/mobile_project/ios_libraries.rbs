module Fledge
  class MobileProject
    class IOSLibraries
      FOLDER: String
      PREFIX: String
      UNSAFE: Regexp
      PLATFORMS: Hash[String, String]

      @built: MobileExtensions::Built
      @identifier: String
      @version: String
      @frameworks: Hash[String, Hash[String, MobileExtensions::FfiLibrary]]?

      def self.framework_name: (MobileExtensions::FfiLibrary library) -> String

      def self.target: (String path, String name) -> String

      def self.info: (String name, identifier: String, version: String, platform: String) -> Hash[String, String | Array[String]]

      def self.xcframework: (String project, String name, Hash[String, String] slices, identifier: String, version: String, ?manifests: Hash[String, String], ?index: String?) -> void

      private def self.framework: (String folder, String name, String path, String? manifest, json: String, info: Hash[String, String | Array[String]]) -> void

      def initialize: (MobileExtensions::Built built, identifier: String, version: String) -> void

      def frameworks: () -> Hash[String, Hash[String, MobileExtensions::FfiLibrary]]

      def call: (String project) -> Array[String]

      def link: (String ruby_root) -> void

      private def named: (Array[MobileExtensions::FfiLibrary] libraries) -> Hash[String, MobileExtensions::FfiLibrary]
    end
  end
end
