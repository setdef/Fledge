module Fledge
  class Squashfs
    type data = [Integer, Array[Integer], Integer?, Integer, Integer]

    BLOCK_SIZE: Integer
    METADATA: Integer
    MAGIC: Integer
    GZIP: Integer
    NO_XATTRS: Integer
    UNCOMPRESSED: Integer
    METADATA_UNCOMPRESSED: Integer
    DIRECTORY: Integer
    FILE: Integer
    SYMLINK: Integer
    EXTENDED_DIRECTORY: Integer
    NONE: Integer
    RUN: Integer
    NAME_MAX: Integer
    SUPERBLOCK: Integer

    @io: IO
    @base: Integer
    @mtime: Integer
    @root: Node
    @fragments: Array[[Integer, Integer]]
    @fragment: String

    def initialize: (IO io, ?mtime: Integer) -> void

    def add: (Entry entry) -> void

    def finish: () -> Integer

    private def child_folder: (Node node, String name, String path) -> Node

    private def write_file: (String bytes) -> data

    private def write_block: (String block) -> Integer

    private def flush_fragment: () -> void

    private def post_order: (Node node, Node? parent) -> Array[[Node, Node?]]

    private def write_tables: (String inodes, String directories) -> Hash[Symbol, Integer]

    private def lookup_table: (Array[String] records) -> Integer

    private def superblock: (Integer count, Integer used, Hash[Symbol, Integer] tables) -> String
  end
end
