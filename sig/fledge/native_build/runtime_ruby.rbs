module Fledge
  class NativeBuild
    class RuntimeRuby
      @platform: Platform
      @runtimes: Runtimes
      @work: String
      @log: CLI::_Output
      @env: Runtimes::_Env
      @prefix: String
      @ruby: String?

      def initialize: (platform: Platform, runtimes: Runtimes, work: String, log: CLI::_Output, env: Runtimes::_Env, ?prefix: String) -> void

      def run: (Array[Hash[String, String | Array[String]]] jobs, ?source: String, ?message: String, ?failure: String) -> Array[Hash[String, String | Array[String]]]

      private def failed: (String result, String failure) -> String

      private def prepare: () -> String

      def home: () -> String

      def env: () -> Hash[String, String?]

      private def gem_libraries: (Hash[String, String?] env) -> void

      private def pkg_config_path: (String given) -> String?
    end
  end
end
