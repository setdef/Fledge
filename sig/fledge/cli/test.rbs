module Fledge
  class CLI
    class Test
      type build = ^(Array[String] arguments, StringIO printed) -> Integer
      type run = ^(MobilePlatform phone, App app, String project, String? device) -> Integer

      DEFAULT_OUT: String

      class Options < Data
        attr_reader phone: String
        attr_reader program: String
        attr_reader out: String
        attr_reader device: String?

        def self.new: (phone: String, program: String, out: String, device: String?) -> instance

        def self.parse: (Array[String] argv) -> Options

        private def self.value: (String option, Array[String] arguments, String what) -> String
      end

      @out: CLI::_Output
      @err: CLI::_Output
      @env: Runtimes::_Env
      @build: build
      @run: run

      def initialize: (out: CLI::_Output, err: CLI::_Output, ?env: Runtimes::_Env, ?build: build?, ?run: run?) -> void

      def call: (Array[String] argv) -> Integer

      private def run: (MobilePlatform phone, App app, String project, String? device) -> Integer
    end
  end
end
