module Fledge
  class ModificationNotice < Data
    PATH: String
    SOURCE: String

    attr_reader programs: Hash[String, Identity]
    attr_reader date: Time

    def self.new: (programs: Hash[String, Identity], date: Time) -> instance

    def self.date: (Runtimes::_Env env) -> Time

    def text: (String app) -> String

    private def program: (String file_name, Identity identity, String app) -> String

    private def icon: (Identity identity, String app) -> String
  end
end
