module Fledge
  class App < Data
    NEVER_SHIPPED: Array[String]
    MARKERS: Array[String]
    RESERVED: Regexp

    attr_reader root: String
    attr_reader name: String
    attr_reader gemfile: String?
    attr_reader config: Config
    attr_reader programs: Array[App::Program]

    def self.new: (root: String, name: String, gemfile: String?, config: Config, programs: Array[App::Program]) -> instance

    def self.at: (String path, ?home: String) -> App

    private def self.listed: (String path, String full, String root, Config config, Gem::Specification? gemspec, String? gemfile) -> App

    private def self.program_of: (Config::Program program, String root, Config config, Gem::Specification? gemspec, String? project) -> App::Program

    private def self.unique: (Array[App::Program] programs, String file) -> void

    private def self.project_root: (String start) -> String?

    private def self.marked?: (String folder) -> bool

    private def self.same_folder?: (String one, String other) -> bool

    private def self.gemspec_in: (String root) -> Gem::Specification?

    private def self.default_entry: (String path, String folder, String root, Gem::Specification? gemspec) -> String

    private def self.relative: (String full, String root) -> String

    private def self.gemfile_in: (String root, Gem::Specification? gemspec) -> String?

    private def self.name_for: (Config config, Gem::Specification? gemspec, String root) -> String

    def self.camelize: (String name) -> String

    private def self.valid_name: (String name, String what) -> String

    def entries: (?skip: Array[String]) -> Array[Entry]

    def main: () -> App::Program

    def entry: () -> String

    def identity: () -> Identity
  end
end
