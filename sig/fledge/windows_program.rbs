module Fledge
  class WindowsProgram
    type key = Integer | String
    type resource = [key, key, key]

    RT_ICON: Integer
    RT_GROUP_ICON: Integer
    RT_VERSION: Integer
    RT_MANIFEST: Integer
    RESOURCE_DIRECTORY: Integer
    CERTIFICATE_DIRECTORY: Integer
    RELOCATION_DIRECTORY: Integer
    CONSOLE: Integer
    GUI: Integer

    @bytes: String
    @headers: Headers

    def initialize: (String bytes) -> void

    def subsystem: () -> Integer

    def resources: () -> Hash[resource, String]

    def with_resources: (Hash[resource, String] resources) -> String

    def self.checksum: (String bytes, Integer field) -> Integer

    private def resource_section: () -> Headers::Section?

    private def check_rewritable: () -> void

    private def each_entry: (Headers::Section section, Integer offset) { (key, Integer) -> void } -> void

    private def resource_name: (Headers::Section section, Integer offset) -> String
  end
end
